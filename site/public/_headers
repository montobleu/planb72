/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://nviv.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://nviv.io; connect-src 'self' https://nviv.io; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), interest-cohort=()

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/data/*.geojson
  Content-Type: application/geo+json

---
import { getCollection } from 'astro:content';
interface Props { module: string; titel?: string }
const { module, titel = 'Uitgebreide gidsen' } = Astro.props;
const lijst = (await getCollection('gidsen')).filter((g) => g.data.module === module).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
{lijst.length > 0 && (
  <section>
    <h2>{titel}</h2>
    <div class="raster">
      {lijst.map((g) => <a class="tegel" href={`/app/gids/${g.id}/`}><strong>{g.data.titel}</strong><span class="klein">{g.data.kort}</span></a>)}
    </div>
  </section>
)}

---
// Kleurschema: standaard donker (zuinig op de batterij), licht als keuze van de gebruiker.
// De keuze staat in localStorage en wordt vóór het tekenen in <meta name="color-scheme"> gezet;
// de CSS leest die meta (zie global.css).
---
<meta name="color-scheme" content="dark" />
<script is:inline>
  try { if (localStorage.getItem('pb72-kleurschema') === 'light') document.querySelector('meta[name="color-scheme"]').content = 'light'; } catch (e) {}
</script>

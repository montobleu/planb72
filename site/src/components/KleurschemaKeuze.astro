---
// Drie standen in een instellingenscherm (Modern Web Guidance: dark-mode-toggle).
import { APP } from '../i18n/app';
import type { Taal } from '../i18n/talen';
interface Props { taal: Taal }
const t = APP[Astro.props.taal].kleurschema;
---
<fieldset class="kleurschema">
  <legend class="sr-only">{t.legende}</legend>
  <label><input type="radio" name="kleurschema" value="system" /> {t.systeem} <span class="klein" data-systeem></span></label>
  <label><input type="radio" name="kleurschema" value="light" /> {t.licht}</label>
  <label><input type="radio" name="kleurschema" value="dark" /> {t.donker}</label>
  <p class="klein">{t.oled}</p>
</fieldset>
<script>
  import { huidigeKeuze, zetKeuze, volgWijzigingen, type Keuze } from '../lib/kleurschema';
  import { klant } from '../i18n/klant';
  const tk = klant().kleurschema;
  const knoppen = [...document.querySelectorAll<HTMLInputElement>('input[name="kleurschema"]')];
  const systeem = document.querySelector('[data-systeem]')!;
  const toonSysteem = () => (systeem.textContent = matchMedia('(prefers-color-scheme: dark)').matches ? tk.nuDonker : tk.nuLicht);
  const k = huidigeKeuze();
  knoppen.forEach((r) => {
    r.checked = r.value === k;
    r.addEventListener('change', () => zetKeuze(r.value as Keuze));
  });
  toonSysteem();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', toonSysteem);
  volgWijzigingen();
</script>
<style>
  .kleurschema label { font-weight: 400; display: flex; gap: 10px; align-items: center; margin: 8px 0; min-block-size: 32px; }
  .kleurschema input { width: 20px; height: 20px; }
</style>

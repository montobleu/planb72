---
import { APP } from '../i18n/app';
import type { Taal } from '../i18n/talen';
interface Props { taal: Taal; bron?: string; bronNaam?: string }
const { taal, bron, bronNaam } = Astro.props;
const t = APP[taal].inhoud;
---
<div class="concept" role="note">
  <strong>{t.concept}</strong>{' '}
  {t.conceptTekst}
  {bron && <> {t.officieleBron} <a href={bron}>{bronNaam ?? bron}</a>.</>}
</div>

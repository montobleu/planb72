---
import { APP } from '../i18n/app';
import type { Taal } from '../i18n/talen';
interface Props { taal: Taal; bronnen: { naam: string; url: string }[]; tekst?: string; datum: string; status: string; nagekeken_door?: string }
const { taal, bronnen, tekst = '', datum, status, nagekeken_door } = Astro.props;
// De bronnen die in de tekst vermeld worden, staan al genummerd onder het artikel (zie rehype-bron.mjs).
// Hier alleen de bronnen die wel geraadpleegd zijn maar nergens in de tekst staan.
const overige = bronnen.filter((b) => !tekst.includes(b.url));
const ook: Record<Taal, string> = { nl: 'Ook geraadpleegd', fr: 'Également consulté', de: 'Ebenfalls herangezogen', en: 'Also consulted' };
const t = APP[taal].inhoud;
---
<section class="bron" aria-label={t.bronnen}>
  {overige.length > 0 && (
    <>
      <p><strong>{ook[taal]}</strong></p>
      <ul>{overige.map((b) => <li><a href={b.url}>{b.naam}</a></li>)}</ul>
    </>
  )}
  <p>{t.datum}: {datum}{t.statussen[status] && ` · ${t.status}: ${t.statussen[status]}`}{nagekeken_door && ` · ${t.nagekekenDoor} ${nagekeken_door}`}</p>
  <slot />
</section>

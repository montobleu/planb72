---
import App from '../../../../layouts/App.astro';
import GidsLijst from '../../../../components/GidsLijst.astro';
import { landenVoor, bronNaam } from '../../../../lib/data';
import { APP } from '../../../../i18n/app';
import { pad, taalPaden, taalVan } from '../../../../i18n/talen';
export const getStaticPaths = taalPaden;
const taal = taalVan(Astro.params);
const t = APP[taal].nucleair;
const landen = landenVoor(taal);
const tl = APP[taal].landen;
// Per land de eigen planning: dezelfde centrale kan in twee landen andere zones hebben.
const planning = Object.fromEntries(landen.map((x) => [x.code, { naam: x.naam, code: x.code.toUpperCase(), uitbreiding: x.nucleair.uitbreidingszone_km, sites: x.nucleair.sites }]));
const kmTekst = (x: number | null) => (x === null ? '—' : `${x} km`);
const l = (x: { lang: string }) => (x.lang !== taal ? x.lang : undefined);
---
<App taal={taal} titel={t.titel} tab="meer" vertaalmelding>
  <h1>{t.titel}</h1>
  {landen.map((x) => (
    <div class="melding waarschuwing" data-land={x.code}>
      <strong>{tl.advies(x.naam)}</strong> <span lang={l(x.nucleair.kernboodschap)}>{x.nucleair.kernboodschap.tekst}</span>
      <div class="klein">{t.bron} <a href={x.nucleair.bron}>{x.code === 'be' ? t.crisiscentrum : bronNaam(x.nucleair.bron)}</a></div>
    </div>
  ))}

  <GidsLijst taal={taal} module="nucleair" />

  <h2>{t.afstandTitel}</h2>
  <p class="dempen">{t.afstandUitleg}</p>
  <div class="knoppen">
    <button class="knop hoofd" type="button" id="mijn-positie">{t.positie}</button>
  </div>
  <details>
    <summary>{t.coords}</summary>
    <form id="coords" class="kaart-blok">
      <label for="lat">{t.lat}</label><input id="lat" type="text" inputmode="decimal" required />
      <label for="lon">{t.lon}</label><input id="lon" type="text" inputmode="decimal" required />
      <div class="knoppen"><button class="knop" type="submit">{t.bereken}</button></div>
    </form>
  </details>
  <div id="resultaat" aria-live="polite" data-planning={JSON.stringify(planning)}></div>

  <h2>{t.sitesTitel}</h2>
  {landen.map((x) => {
    const n = x.nucleair;
    return (
      <section data-land={x.code}>
        <h3>{tl.planning(x.naam)}</h3>
        <div class="tabel-wrap">
          <table>
            <thead><tr>{t.kop.map((k) => <th scope="col">{k}</th>)}</tr></thead>
            <tbody>
              {n.sites.map((s) => (
                <tr><td>{s.naam}{s.land.toLowerCase() !== x.code && <span class="klein"> ({s.land})</span>}</td><td>{s.soort}</td><td>{kmTekst(s.schuilen_km)}</td><td>{kmTekst(s.jodium_km)}</td><td>{kmTekst(s.evacuatie_km)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p lang={l(n.opmerking)}>{n.opmerking.tekst}</p>
        {x.code === 'be'
          ? <p class="klein" set:html={t.zones(n.zones_bron, n.coordinaten_status.tekst)} />
          : <p class="klein">{tl.zones} <a href={n.zones_bron}>{bronNaam(n.zones_bron)}</a>{n.jodium_bron && <>; {tl.jodium} <a href={n.jodium_bron}>{bronNaam(n.jodium_bron)}</a></>}. <span lang={l(n.coordinaten_status)}>{tl.coordinaten(n.coordinaten_status.tekst)}</span></p>}
      </section>
    );
  })}
  <p class="klein">{tl.zonesUitleg}</p>
  <div class="knoppen"><a class="knop" href={pad(taal, '/app/kaart/?laag=nucleair')}>{t.opKaart}</a></div>
</App>
<script>
  import { afstandKm, richting, km, positie, bewaar } from '../../../../lib/app';
  import { klant } from '../../../../i18n/klant';
  const tk = klant().nucleair;
  import { gekozenLanden } from '../../../../lib/landkeuze';
  type Site = { naam: string; land: string; lat: number; lon: number; schuilen_km: number | null; evacuatie_km: number | null; uitbreidingszone_km?: number | null; kerncentrale: boolean };
  type Planning = { naam: string; code: string; uitbreiding: number | null; sites: Site[] };
  const uit = document.getElementById('resultaat')!;
  const planning: Record<string, Planning> = JSON.parse(uit.dataset.planning!);
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let laatste: [number, number] | null = null;

  function tabel(p: Planning, lat: number, lon: number) {
    const rijen = p.sites
      .map((s) => ({ s, d: afstandKm(lat, lon, s.lat, s.lon), r: richting(lat, lon, s.lat, s.lon) }))
      .sort((a, b) => a.d - b.d);
    const zones = (x: (typeof rijen)[number]) => {
      const z: string[] = [];
      const uitbreiding = x.s.uitbreidingszone_km ?? (x.s.kerncentrale ? p.uitbreiding : null);
      if (x.s.evacuatie_km && x.d <= x.s.evacuatie_km) z.push(tk.evacuatie);
      if (x.s.schuilen_km && x.d <= x.s.schuilen_km) z.push(tk.schuilen);
      else if (uitbreiding && x.d <= uitbreiding) z.push(`${tk.uitbreiding} (${uitbreiding} km)`);
      return z.length ? z.join(', ') : '—';
    };
    return `<h3>${esc(klant().landen.volgensPlanning(p.naam))}</h3><div class="tabel-wrap"><table><thead><tr>${tk.kop.map((k) => `<th scope="col">${esc(k)}</th>`).join('')}</tr></thead><tbody>${rijen
      .map((x) => `<tr><td>${esc(x.s.naam)}</td><td>${km(x.d)}</td><td>${x.r.windstreek} (${x.r.graden}°)</td><td>${zones(x)}</td></tr>`)
      .join('')}</tbody></table></div>`;
  }

  function toon(lat: number, lon: number) {
    laatste = [lat, lon];
    const lijst = gekozenLanden().map((c) => planning[c]).filter(Boolean);
    uit.innerHTML = lijst.map((p) => tabel(p, lat, lon)).join('') +
      `<p class="klein">${esc(tk.vogelvlucht(`${lat.toFixed(4)}, ${lon.toFixed(4)}`))} ${esc(klant().landen.zonesGelden)}</p>`;
  }
  document.addEventListener('pb72-landen', () => laatste && toon(...laatste));

  document.getElementById('mijn-positie')!.addEventListener('click', async () => {
    uit.textContent = tk.zoeken;
    const p = await positie();
    if (!p) { uit.textContent = tk.geen; return; }
    bewaar('positie', { lat: p.coords.latitude, lon: p.coords.longitude, naam: tk.laatste });
    toon(p.coords.latitude, p.coords.longitude);
  });
  document.getElementById('coords')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const lat = parseFloat((document.getElementById('lat') as HTMLInputElement).value.replace(',', '.'));
    const lon = parseFloat((document.getElementById('lon') as HTMLInputElement).value.replace(',', '.'));
    if (Number.isFinite(lat) && Number.isFinite(lon)) toon(lat, lon);
  });
</script>

---
import App from '../../../../layouts/App.astro';
import GidsLinks from '../../../../components/GidsLinks.astro';
import { landenVoor } from '../../../../lib/data';
import { APP } from '../../../../i18n/app';
import { pad, taalPaden, taalVan } from '../../../../i18n/talen';
export const getStaticPaths = taalPaden;
const taal = taalVan(Astro.params);
const t = APP[taal].nummers;
const landen = landenVoor(taal);
const tl = APP[taal].landen;
---
<App taal={taal} titel={t.titel} tab="nummers" vertaalmelding>
  <h1>{t.titel}</h1>
  <p class="dempen">{t.uitleg} <Fragment set:html={tl.welke(pad(taal, '/app/pakket/#landen'))} /></p>
  {landen.map((land) => (
    <section data-land={land.code}>
      <h2>{land.naam}</h2>
      <div>
        {land.noodnummers.map((n) => (
          <div class={`nummer${n.dringend ? ' dringend' : ''}`}>
            <a class="tel" href={`tel:${n.nummer.replace(/[\s-]/g, '')}`}>{n.nummer}</a>
            <div><span lang={n.wat.lang !== taal ? n.wat.lang : undefined}>{n.wat.tekst}</span> <a class="klein" href={n.bron}>{APP[taal].algemeen.bron}</a></div>
          </div>
        ))}
      </div>
      <p class="klein">{t.controle(land.bijgewerkt)}</p>
    </section>
  ))}
  <h2>{t.oproepTitel}</h2>
  <ol>{t.oproep.map((r) => <li>{r}</li>)}</ol>
  <p class="klein">{t.oproepBron} <a href="https://www.112.be">112.be</a>.</p>
  <div class="knoppen niet-afdrukken"><button class="knop" type="button" onclick="print()">{APP[taal].algemeen.afdrukken}</button></div>
  <GidsLinks taal={taal} ids={['noodoproep']} />
</App>

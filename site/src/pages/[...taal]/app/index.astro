---
import App from '../../../layouts/App.astro';
import { landenVoor } from '../../../lib/data';
import { APP } from '../../../i18n/app';
import { TALEN, TAALNAMEN, pad, taalPaden, taalVan } from '../../../i18n/talen';
export const getStaticPaths = taalPaden;
const taal = taalVan(Astro.params);
const t = APP[taal].start;
const landen = landenVoor(taal);
const tl = APP[taal].landen;
---
<App taal={taal} titel={t.titel} tab="start">
  <h1 class="sr-only">PlanB72</h1>

  <div id="pakket-melding" class="melding" hidden>
    <strong>{t.pakketTitel}</strong> {landen.map((l) => <span data-land={l.code}>{t.pakketTekst(l.naam)} </span>)}
    <div class="knoppen"><a class="knop hoofd" href={pad(taal, '/app/pakket/')}>{t.pakketKnop}</a></div>
  </div>

  {t.groepen.map(([titel, items], i) => (
    <section class={['rubriek-nood', 'rubriek-kaart', 'rubriek-voorbereiden', 'rubriek-hulp'][i] ?? 'rubriek-naslag'}>
      <h2 class="sectiekop">{titel}</h2>
      <div class="raster">
        {items.map(([href, tt, uitleg]) => (
          <a class="tegel" href={pad(taal, href)}><strong>{tt}</strong><span class="klein">{uitleg}</span></a>
        ))}
      </div>
    </section>
  ))}

  {taal !== 'nl' && <p class="vertaalmelding klein" role="note" style="margin-top:1.5rem">{APP[taal].algemeen.interfaceVertaald}</p>}
  <p class="klein" style="margin-top:1.5rem">
    {landen.map((l) => <span data-land={l.code}>{t.voet(l.naam, l.bijgewerkt)} · </span>)}
    <a href={pad(taal, '/app/pakket/#landen')}>{tl.anderLand}</a>
  </p>
  <nav class="klein taalregel" aria-label={t.andereTaal}>
    {TALEN.filter((l) => l !== taal).map((l, i) => <>{i > 0 && ' · '}<a href={pad(l, '/app/')} hreflang={l} lang={l} data-taalkeuze={l}>{TAALNAMEN[l]}</a></>)}
  </nav>
</App>
<script>
  import { opToestel } from '../../../lib/kaarten';
  import { gekozenLanden } from '../../../lib/landkeuze';
  // Toon de melding als het basispakket (kaartlagen en overzichtskaarten) nog niet op het toestel staat.
  (async () => {
    try {
      const bewaard = await caches.keys();
      const kaarten = await opToestel();
      const heeft = gekozenLanden().every((c) => bewaard.includes(`pb72-pakket-${c}`) && kaarten.has(`${c}-z9`));
      // ?voorbeeld verbergt de melding voor de schermafbeelding op de website.
      if (!heeft && !location.search.includes('voorbeeld')) document.getElementById('pakket-melding')!.hidden = false;
    } catch {}
  })();
</script>

---
import App from '../../../layouts/App.astro';
import { land } from '../../../lib/data';
const v = land.voorraad;
---
<App titel="Voorraadplanner" tab="meer">
  <h1>Voorraadplanner</h1>
  <p class="dempen">Hoeveel water heb je nodig? Vul in, de app rekent.</p>
  <form id="planner" class="kaart-blok" data-water={v.water_liter_pp_per_dag}>
    <label for="mensen">Aantal personen</label><input id="mensen" type="number" min="1" max="50" value="2" inputmode="numeric" />
    <label for="dieren">Aantal huisdieren</label><input id="dieren" type="number" min="0" max="50" value="0" inputmode="numeric" />
    <label for="dagen">Aantal dagen</label>
    <select id="dagen"><option value="3" selected>3 dagen (72 uur)</option><option value="7">1 week</option><option value="14">2 weken</option></select>
  </form>
  <div id="uitkomst" class="kaart-blok" aria-live="polite"></div>
  <p class="klein">Waarde: {v.water_bron}. <span class="label onbevestigd">{v.water_status}</span></p>
  <p class="klein">Voor huisdieren rekent de planner niets uit: vraag je dierenarts hoeveel water en voer jouw dier per dag nodig heeft, en leg dat apart.</p>
  <p>Wat er nog meer in je voorraad hoort, staat in de <a href="/app/checklists/">checklists</a>.</p>
</App>
<script>
  import { lees, bewaar } from '../../../lib/app';
  const form = document.getElementById('planner') as HTMLFormElement;
  const perDag = Number(form.dataset.water);
  const veld = (id: string) => document.getElementById(id) as HTMLInputElement;
  const bewaard = lees('voorraad', { mensen: 2, dieren: 0, dagen: 3 });
  veld('mensen').value = String(bewaard.mensen); veld('dieren').value = String(bewaard.dieren); veld('dagen').value = String(bewaard.dagen);
  function reken() {
    const mensen = Math.max(1, Number(veld('mensen').value) || 1);
    const dieren = Math.max(0, Number(veld('dieren').value) || 0);
    const dagen = Number(veld('dagen').value) || 3;
    bewaar('voorraad', { mensen, dieren, dagen });
    const liter = mensen * dagen * perDag;
    document.getElementById('uitkomst')!.innerHTML =
      `<p style="font-size:1.4rem;margin:0"><strong>${liter} liter water</strong></p>` +
      `<p class="klein">${mensen} × ${dagen} dagen × ${perDag} liter. Dat zijn ongeveer ${Math.ceil(liter / 6)} packs van 6 liter.</p>` +
      `<p class="klein">Plus water en voer voor ${dieren} huisdier${dieren === 1 ? '' : 'en'} voor ${dagen} dagen.</p>`;
  }
  form.addEventListener('input', reken);
  reken();
</script>

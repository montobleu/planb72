---
import App from '../../../layouts/App.astro';
import { getCollection } from 'astro:content';
const kaarten = (await getCollection('scenarios')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<App titel="Wat nu?" tab="watnu">
  <h1>Wat nu?</h1>
  <p class="dempen">Kies de situatie om de eerste handelingen te zien.</p>
  <div class="raster">
    {kaarten.map((k) => (
      <a class="tegel" href={`/app/wat-nu/${k.id}/`}>
        <strong>{k.data.titel}</strong>
        <span class="klein">{k.data.kort}</span>
      </a>
    ))}
  </div>
</App>

---
import App from '../../../layouts/App.astro';
import Concept from '../../../components/Concept.astro';
import Inhoudstafel from '../../../components/Inhoudstafel.astro';
import Brondoos from '../../../components/Brondoos.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const kaarten = await getCollection('scenarios');
  return kaarten.map((k) => ({ params: { id: k.id }, props: { kaart: k } }));
}
const { kaart } = Astro.props;
const { Content, headings } = await render(kaart);
const d = kaart.data;
---
<App titel={d.titel} tab="watnu">
  <p class="klein niet-afdrukken"><a href="/app/wat-nu/">Alle situaties</a></p>
  <h1>{d.titel}</h1>
  <p class="lead">{d.kort}</p>
  <div class="melding gevaar"><strong>Levensgevaar: bel <a href="tel:112">112</a>.</strong></div>

  <section class="eerste-stappen" aria-labelledby="eerste">
    <h2 id="eerste">Eerste stappen</h2>
    <ol class="stappen">{d.stappen.map((s) => <li>{s}</li>)}</ol>
    {d.niet && (
      <>
        <h2>Vermijden</h2>
        <ul>{d.niet.map((n) => <li>{n}</li>)}</ul>
      </>
    )}
  </section>

  {d.status === 'concept' && <Concept bron={d.bronnen[0].url} bronNaam={d.bronnen[0].naam} />}
  <Inhoudstafel koppen={headings} />
  <article class="inhoud"><Content /></article>
  <Brondoos bronnen={d.bronnen} datum={d.datum} status={d.status} nagekeken_door={d.nagekeken_door} />
  <div class="knoppen niet-afdrukken"><button class="knop" type="button" onclick="print()">Afdrukken</button></div>
</App>

---
import App from '../../../layouts/App.astro';
import { land } from '../../../lib/data';
const dreigingen = [
  ['Luchtaanval of explosie', 'Ondergronds: kelder, parking, metro, tunnel', 'Bij ramen, in portieken, op trappen'],
  ['Radioactieve neerslag', 'Zo diep en zo centraal mogelijk in een stevig gebouw', 'Buiten, in de auto'],
  ['Overstroming of wolkbreuk', 'Omhoog: bovenverdieping, hoger gelegen terrein', 'Alles wat ondergronds is'],
  ['Brand of rook in het gebouw', 'Naar buiten', 'Ondergrondse ruimtes met één uitgang'],
  ['Chemische wolk', 'Volg het officiële advies: binnen, ramen dicht, ventilatie uit', 'Laaggelegen ruimtes als het gas zwaarder is dan lucht'],
];
const klassen = [
  ['A', 'Officiële openbare schuilplaats', 'In België: geen.', 'officieel'],
  ['B', 'Ondergronds en stevig', 'Parkings, metrostations, tunnels. Bestaat zeker; niet ontworpen als schuilplaats.', 'osm'],
  ['C', 'Historische bunkers en forten', 'Locatie klopt; vaak privé, afgesloten of onveilig. Niet betreden.', 'onbevestigd'],
];
const huis = [
  'De ruimte ligt onder de grond of zo laag en centraal mogelijk.',
  'Er zijn minstens twee muren tussen jou en buiten.',
  'Er zijn geen of weinig ramen.',
  'Er is een tweede uitgang, zodat puin je niet insluit.',
  'Er staat niets zwaars boven dat kan instorten.',
  'Er liggen water, licht, een radio op batterijen, iets om op te zitten en een emmer als toilet.',
];
---
<App titel="Schuilen" tab="meer">
  <h1>Schuilen</h1>
  <div class="melding waarschuwing">
    <strong>{land.naam.nl}:</strong> {land.schuilen.advies}
    <div class="klein"><a href={land.schuilen.bron}>Bron</a></div>
  </div>

  <h2>Het hangt af van de dreiging</h2>
  <p class="dempen">De geschikte plek hangt af van de dreiging.</p>
  <div class="tabel-wrap">
    <table>
      <thead><tr><th scope="col">Dreiging</th><th scope="col">Waarheen</th><th scope="col">Waar niet</th></tr></thead>
      <tbody>{dreigingen.map(([d, w, n]) => <tr><th scope="row">{d}</th><td>{w}</td><td>{n}</td></tr>)}</tbody>
    </table>
  </div>
  <p class="klein">Overstroming, luchtaanval en neerslag: <a href="https://www.berlin.de/ba-tempelhof-schoeneberg/service/bevoelkerungsschutz/artikel.1656638.php">Duitse officiële gids</a>. Brand en chemisch: algemene regel, wordt vervangen door de officiële Belgische tekst.</p>

  <h2>Schuilplek in de eigen woning</h2>
  <p class="dempen">Checklist op basis van de Tsjechische en Duitse overheidsgidsen.</p>
  <ul class="vinklijst" data-lijst="schuilen-huis">
    {huis.map((h, i) => <li><input type="checkbox" id={`h${i}`} /><label for={`h${i}`}>{h}</label></li>)}
  </ul>

  <h2>Mogelijke schuilplekken op de kaart</h2>
  {klassen.map(([k, naam, uitleg, soort]) => (
    <div class="kaart-blok"><strong>Klasse {k}: {naam}</strong> <span class={`label ${soort}`}>{soort === 'osm' ? 'OpenStreetMap' : soort}</span><p class="klein">{uitleg}</p></div>
  ))}
  <p>Elk punt uit OpenStreetMap draagt het label: <em>Mogelijke schuilplek. Niet officieel aangewezen. Toegang en toestand onbekend.</em></p>
  <div class="knoppen"><a class="knop" href="/app/kaart/?laag=schuilplekken">Toon mogelijke schuilplekken</a></div>
  <p class="klein">Openingsuren en toegang kunnen rechtstreeks in OpenStreetMap worden aangevuld; de volgende update neemt ze over.</p>
</App>
<script>
  import { vinklijsten } from '../../../lib/app';
  vinklijsten();
</script>

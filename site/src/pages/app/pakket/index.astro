---
import App from '../../../layouts/App.astro';
import { land, APP_VERSIE } from '../../../lib/data';
import { LAGEN } from '../../../lib/lagen';
import KleurschemaKeuze from '../../../components/KleurschemaKeuze.astro';
---
<App titel="Instellingen" tab="meer" zoekbaar={false}>
  <h1>Instellingen en pakket</h1>

  <section class="kaart-blok">
    <h2 style="margin-top:0">Pakket {land.naam.nl} — Zak</h2>
    <p id="pakket-staat" aria-live="polite">Controleren…</p>
    <progress id="voortgang" max="100" value="0" hidden style="width:100%"></progress>
    <div class="knoppen">
      <button class="knop hoofd" type="button" id="download">Pakket downloaden</button>
      <button class="knop gevaar" type="button" id="verwijder" hidden>Verwijderen</button>
    </div>
    <p class="klein">De app zelf staat al op dit toestel zodra je hem één keer opende. Het pakket voegt de kaart en de kaartlagen toe. Download op wifi.</p>
  </section>

  <section>
    <h2>Installeren op je beginscherm</h2>
    <p id="installeer-uitleg">Op Android: menu ⋮ → <em>App installeren</em> of <em>Toevoegen aan startscherm</em>. Op iPhone: deelknop → <em>Zet op beginscherm</em>.</p>
    <div class="knoppen"><button class="knop" type="button" id="installeer" hidden>Installeren</button></div>
  </section>

  <section>
    <h2>Weergave</h2>
    <KleurschemaKeuze />
  </section>

  <section>
    <h2>Toestel</h2>
    <div class="tabel-wrap"><table><tbody id="toestel"></tbody></table></div>
  </section>

  <section>
    <h2>Versheid</h2>
    <div class="tabel-wrap"><table><tbody id="versheid">
      <tr><th>App</th><td>versie {APP_VERSIE}</td></tr>
      <tr><th>Landinfo {land.naam.nl}</th><td>{land.bijgewerkt}</td></tr>
    </tbody></table></div>
  </section>

  <section>
    <h2>Delen</h2>
    <p>Deel de link met familie en buren zolang er een verbinding is. Zonder internet kan PlanB72 worden doorgegeven via de computerversie of een USB-stick (zie <a href="/download/">planb72.org/download</a>).</p>
    <div class="knoppen"><button class="knop" type="button" id="deel">Link delen</button></div>
  </section>

  <div id="lagen" data-lagen={JSON.stringify(LAGEN.map((l) => l.id))} hidden></div>
</App>
<script>
  import { vraagBlijvendeOpslag, bewaar } from '../../../lib/app';
  const LAND = 'be';
  const CACHE = `pb72-pakket-${LAND}`;
  const DATA = `/data/${LAND}`;
  const lagen: string[] = JSON.parse(document.getElementById('lagen')!.dataset.lagen!);
  const staat = document.getElementById('pakket-staat')!;
  const voortgang = document.getElementById('voortgang') as HTMLProgressElement;
  const dl = document.getElementById('download') as HTMLButtonElement;
  const weg = document.getElementById('verwijder') as HTMLButtonElement;
  const mb = (b: number) => `${(b / 1024 / 1024).toLocaleString('nl-BE', { maximumFractionDigits: 1 })} MB`;

  async function bekijk() {
    try {
      const cache = await caches.open(CACHE);
      const sleutels = await cache.keys();
      const meta = await (await cache.match(`${DATA}/meta.json`))?.json().catch(() => null);
      if (sleutels.length) {
        staat.innerHTML = `<span class="label officieel">op dit toestel</span> ${sleutels.length} bestanden${meta?.opgehaald ? `, kaartdata van ${meta.opgehaald}` : ''}.`;
        dl.textContent = navigator.onLine ? 'Bijwerken' : 'Bijwerken (geen verbinding)';
        weg.hidden = false;
      } else {
        staat.innerHTML = '<span class="label onbevestigd">nog niet offline</span> Download het pakket zolang je verbinding hebt.';
        weg.hidden = true;
      }
    } catch {
      staat.textContent = 'Deze browser laat geen offline opslag toe (privévenster?).';
      dl.disabled = true;
    }
  }

  dl.addEventListener('click', async () => {
    if (!navigator.onLine) { staat.textContent = 'Geen verbinding. Probeer later opnieuw.'; return; }
    dl.disabled = true;
    await vraagBlijvendeOpslag();
    const meta = await fetch(`${DATA}/meta.json`, { cache: 'no-store' }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const bestanden = [`${DATA}/meta.json`, `${DATA}/nucleair.geojson`, ...lagen.map((l) => `${DATA}/${l}.geojson`), `${DATA}/basis.pmtiles`];
    const verwacht = bestanden.reduce((t, b) => t + (meta?.lagen?.[b.split('/').pop()!.replace('.geojson', '')]?.bytes ?? 0), 0);
    const cache = await caches.open(CACHE);
    voortgang.hidden = false;
    let klaar = 0, bytes = 0;
    const mislukt: string[] = [];
    for (const b of bestanden) {
      staat.textContent = `Downloaden: ${b.split('/').pop()} (${mb(bytes)}${verwacht ? ` van ongeveer ${mb(verwacht)}` : ''})`;
      try {
        const r = await fetch(b, { cache: 'no-store' });
        if (!r.ok) { if (r.status !== 404) mislukt.push(b); continue; }
        const blob = await r.blob();
        bytes += blob.size;
        // Pas vervangen als het nieuwe bestand volledig binnen is.
        await cache.put(b, new Response(blob, { headers: { 'Content-Type': r.headers.get('Content-Type') ?? 'application/octet-stream' } }));
      } catch { mislukt.push(b); }
      voortgang.value = (++klaar / bestanden.length) * 100;
    }
    voortgang.hidden = true;
    dl.disabled = false;
    bewaar('pakket-datum', new Date().toISOString());
    await bekijk();
    if (mislukt.length) staat.innerHTML += `<br><span class="label onbevestigd">${mislukt.length} bestand(en) niet gelukt</span> Probeer opnieuw.`;
    else staat.innerHTML += ` (${mb(bytes)})`;
    toestel();
  });

  weg.addEventListener('click', async () => {
    if (!confirm('Het pakket van dit toestel verwijderen? De kaart werkt dan niet meer offline.')) return;
    await caches.delete(CACHE);
    await bekijk(); toestel();
  });

  async function toestel() {
    const rijen: [string, string][] = [];
    rijen.push(['Verbinding', navigator.onLine ? 'online' : 'offline']);
    try {
      const s = await navigator.storage?.estimate?.();
      if (s?.usage !== undefined) rijen.push(['Opslag gebruikt door PlanB72', `${mb(s.usage)}${s.quota ? ` (ruimte tot ${mb(s.quota)})` : ''}`]);
      const blijvend = await navigator.storage?.persisted?.();
      rijen.push(['Opslag beschermd tegen wissen', blijvend ? 'ja' : 'nee (de browser kan het pakket wissen bij weinig ruimte)']);
    } catch {}
    try {
      const bat = await (navigator as any).getBattery?.();
      if (bat) rijen.push(['Batterij', `${Math.round(bat.level * 100)}%${bat.charging ? ', laadt' : ''}`]);
    } catch {}
    rijen.push(['Gps', 'geolocation' in navigator ? 'aanwezig (vraagt toestemming)' : 'niet beschikbaar']);
    const sw = navigator.serviceWorker?.controller ? 'actief: de app werkt offline' : 'nog niet actief (herlaad de pagina één keer)';
    rijen.push(['Offline app', sw]);
    document.getElementById('toestel')!.innerHTML = rijen.map(([a, b]) => `<tr><th>${a}</th><td>${b}</td></tr>`).join('');
  }

  // Installeren: alleen tonen als de browser het aanbiedt.
  let aanbod: any = null;
  addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); aanbod = e; document.getElementById('installeer')!.hidden = false; });
  document.getElementById('installeer')!.addEventListener('click', async () => { if (!aanbod) return; aanbod.prompt(); aanbod = null; });
  if (matchMedia('(display-mode: standalone)').matches) document.getElementById('installeer-uitleg')!.textContent = 'PlanB72 staat al op je beginscherm.';

  document.getElementById('deel')!.addEventListener('click', async () => {
    const data = { title: 'PlanB72', text: 'Gratis noodbibliotheek die werkt zonder internet.', url: 'https://planb72.org/' };
    try { if (navigator.share) await navigator.share(data); else { await navigator.clipboard.writeText(data.url); alert('Link gekopieerd.'); } } catch {}
  });

  bekijk(); toestel();
</script>

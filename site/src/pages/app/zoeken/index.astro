---
import App from '../../../layouts/App.astro';
---
<App titel="Zoeken" zoekbaar={false}>
  <h1>Zoeken</h1>
  <p class="dempen">Zoekt in alle teksten van de app, ook offline.</p>
  <label for="zoek">Zoekterm</label>
  <input id="zoek" type="search" placeholder="bijvoorbeeld: water, storm, 1722" autocomplete="off" />
  <div id="resultaten" aria-live="polite"></div>
</App>
<script>
  const veld = document.getElementById('zoek') as HTMLInputElement;
  const uit = document.getElementById('resultaten')!;
  let pf: any = null;
  async function pagefind() {
    if (!pf) {
      // De index wordt bij de build gemaakt; in de ontwikkelserver bestaat hij niet.
      const pad = '/pagefind/pagefind.js';
      pf = await import(/* @vite-ignore */ pad).catch(() => null);
      await pf?.options?.({ excerptLength: 20 });
    }
    return pf;
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  let teller = 0;
  veld.addEventListener('input', async () => {
    const nr = ++teller;
    const term = veld.value.trim();
    if (term.length < 2) { uit.replaceChildren(); return; }
    const p = await pagefind();
    if (!p) { uit.textContent = 'Zoeken is niet beschikbaar in deze versie.'; return; }
    const r = await p.debouncedSearch(term, {}, 150);
    if (!r || nr !== teller) return;
    const data = await Promise.all(r.results.slice(0, 12).map((x: any) => x.data()));
    uit.innerHTML = data.length
      ? data.map((d: any) => `<a class="kaart-blok" style="display:block;text-decoration:none;color:inherit" href="${esc(d.url)}"><strong>${esc(d.meta?.title ?? d.url)}</strong><br><span class="klein">${d.excerpt}</span></a>`).join('')
      : '<p>Niets gevonden.</p>';
  });
  veld.focus();
</script>

---
import App from '../../../layouts/App.astro';
import { LAGEN } from '../../../lib/lagen';
const groepen = [...new Set(LAGEN.map((l) => l.groep))];
---
<App titel="Kaart" tab="kaart" volledig>
  <main id="inhoud" class="kaart-pagina">
    <h1 class="sr-only">Kaart</h1>
    <div id="kaart" role="region" aria-label="Kaart"></div>
    <div class="kaart-paneel">
      <details id="paneel" open>
        <summary>Lagen</summary>
        {groepen.map((g) => (
          <fieldset style="margin:.4rem 0;padding:4px 8px">
            <legend class="klein">{g}</legend>
            {LAGEN.filter((l) => l.groep === g).map((l) => (
              <label><input type="checkbox" data-laag={l.id} checked={l.standaard} /><span class="bol" style={`background:${l.kleur}`}></span>{l.naam} <span class="klein" data-aantal={l.id}></span></label>
            ))}
          </fieldset>
        ))}
        <fieldset style="margin:.4rem 0;padding:4px 8px">
          <legend class="klein">Risico's</legend>
          <label><input type="checkbox" data-laag="nucleair" checked /><span class="bol" style="background:#ffb020"></span>Nucleaire zones</label>
        </fieldset>
        <div class="knoppen" style="margin:.5rem 0 0">
          <button class="knop hoofd" type="button" id="dichtstbij">Dichtstbij</button>
        </div>
        <div id="dichtst" class="klein" aria-live="polite"></div>
        <p class="klein" id="kaart-status"></p>
        <p class="klein">De kaart toont locaties, niet of een voorziening open of beschikbaar is. <span class="label osm">OpenStreetMap</span></p>
      </details>
    </div>
  </main>
</App>
<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import * as maplibregl from 'maplibre-gl';
  // De worker als eigen bestand meeleveren; MapLibre zoekt hem anders naast een bestand dat niet bestaat.
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
  import { Protocol } from 'pmtiles';
  import { layers, namedFlavor } from '@protomaps/basemaps';
  import type { FeatureCollection, Point } from 'geojson';
  import { LAGEN, SCHUIL_LABEL } from '../../../lib/lagen';
  import { lees, bewaar, positie, afstandKm, richting, km } from '../../../lib/app';
  import { getekendSchema, volgWijzigingen } from '../../../lib/kleurschema';

  const LAND = 'be';
  const DATA = `/data/${LAND}`;
  const status = document.getElementById('kaart-status')!;
  maplibregl.setWorkerUrl(workerUrl);
  // Op een smal scherm begint het lagenpaneel dicht, zodat de kaart zichtbaar is.
  if (matchMedia('(max-width: 640px)').matches) (document.getElementById('paneel') as HTMLDetailsElement).open = false;
  const protocol = new Protocol();
  maplibregl.addProtocol('pmtiles', protocol.tile);

  const licht = getekendSchema() === 'light';
  // Een andere stijl vraagt een nieuwe kaart; herladen is eenvoudig en betrouwbaar.
  document.addEventListener('pb72-kleurschema', () => location.reload());
  volgWijzigingen();
  // GET met een klein bereik in plaats van HEAD: zo antwoordt ook de service worker offline.
  const heeftBasis = await fetch(`${DATA}/basis.pmtiles`, { headers: { Range: 'bytes=0-15' } }).then((r) => r.ok).catch(() => false);

  const stijl: maplibregl.StyleSpecification = {
    version: 8,
    glyphs: `${location.origin}/kaart/fonts/{fontstack}/{range}.pbf`,
    sprite: `${location.origin}/kaart/sprites/${licht ? "light" : "dark"}`,
    sources: heeftBasis
      ? { basis: { type: 'vector', url: `pmtiles://${location.origin}${DATA}/basis.pmtiles`, attribution: '© <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://protomaps.com">Protomaps</a>' } }
      : {},
    layers: heeftBasis
      ? layers('basis', namedFlavor(licht ? 'light' : 'dark'), { lang: 'nl' })
      : [{ id: 'achtergrond', type: 'background', paint: { 'background-color': licht ? '#eef1f3' : '#151a1f' } }],
  };
  if (!heeftBasis) status.textContent = 'Basiskaart niet beschikbaar; alleen de punten worden getoond.';

  const bewaardBeeld = lees<{ c: [number, number]; z: number } | null>('kaartbeeld', null);
  const kaart = new maplibregl.Map({
    container: 'kaart',
    style: stijl,
    center: bewaardBeeld?.c ?? [4.47, 50.64],
    zoom: bewaardBeeld?.z ?? 7,
    maxZoom: 18,
    attributionControl: { compact: true },
    fadeDuration: 0,
  });
  (window as any).__kaart = kaart; // handig bij het nakijken in de browserconsole
  kaart.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  kaart.addControl(new maplibregl.GeolocateControl({ positionOptions: { enableHighAccuracy: true }, trackUserLocation: false }), 'top-right');
  kaart.on('moveend', () => bewaar('kaartbeeld', { c: kaart.getCenter().toArray(), z: kaart.getZoom() }));

  // Welke lagen staan aan: URL (?laag=), anders bewaard, anders standaard.
  const vraag = new URLSearchParams(location.search).get('laag');
  const aan = new Set<string>(
    vraag ? [vraag] : lees<string[] | null>('kaartlagen', null) ?? [...LAGEN.filter((l) => l.standaard).map((l) => l.id), 'nucleair']
  );
  const vinkjes = [...document.querySelectorAll<HTMLInputElement>('input[data-laag]')];
  vinkjes.forEach((v) => (v.checked = aan.has(v.dataset.laag!)));

  const geladen = new Map<string, FeatureCollection>();

  async function laad(id: string) {
    if (geladen.has(id)) return geladen.get(id)!;
    const r = await fetch(`${DATA}/${id}.geojson`);
    if (!r.ok) throw new Error(`${id}: ${r.status}`);
    const fc = (await r.json()) as FeatureCollection;
    geladen.set(id, fc);
    const teller = document.querySelector(`[data-aantal="${id}"]`);
    if (teller) teller.textContent = `(${fc.features.length.toLocaleString('nl-BE')})`;
    return fc;
  }

  async function zetLaag(id: string, zichtbaar: boolean) {
    if (id === 'nucleair') return zetNucleair(zichtbaar);
    const def = LAGEN.find((l) => l.id === id)!;
    if (!kaart.getSource(id)) {
      if (!zichtbaar) return;
      try {
        const fc = await laad(id);
        kaart.addSource(id, { type: 'geojson', data: fc });
        kaart.addLayer({
          id, type: 'circle', source: id,
          paint: {
            'circle-color': def.kleur,
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 6, 2.5, 12, 6, 16, 9],
            'circle-stroke-color': licht ? '#ffffff' : '#000000',
            'circle-stroke-width': 1,
          },
        });
        kaart.on('click', id, (e) => toonPopup(e, def.naam, id));
        kaart.on('mouseenter', id, () => (kaart.getCanvas().style.cursor = 'pointer'));
        kaart.on('mouseleave', id, () => (kaart.getCanvas().style.cursor = ''));
      } catch {
        status.textContent = `Laag "${def.naam}" is niet op dit toestel. Download het pakket.`;
        return;
      }
    }
    kaart.setLayoutProperty(id, 'visibility', zichtbaar ? 'visible' : 'none');
  }

  async function zetNucleair(zichtbaar: boolean) {
    if (!kaart.getSource('nucleair')) {
      if (!zichtbaar) return;
      try {
        const fc = await laad('nucleair');
        kaart.addSource('nucleair', { type: 'geojson', data: fc });
        const zone = (z: string) => ['all', ['==', ['geometry-type'], 'Polygon'], ['==', ['get', 'zone'], z]] as any;
        kaart.addLayer({ id: 'nucleair-uitbreiding', type: 'line', source: 'nucleair', filter: zone('uitbreiding'), paint: { 'line-color': '#ffb020', 'line-width': 1, 'line-dasharray': [2, 3], 'line-opacity': 0.6 } });
        kaart.addLayer({ id: 'nucleair-schuilen', type: 'fill', source: 'nucleair', filter: zone('schuilen'), paint: { 'fill-color': '#ffb020', 'fill-opacity': 0.12, 'fill-outline-color': '#ffb020' } });
        kaart.addLayer({ id: 'nucleair-evacuatie', type: 'fill', source: 'nucleair', filter: zone('evacuatie'), paint: { 'fill-color': '#ff6b5b', 'fill-opacity': 0.18, 'fill-outline-color': '#ff6b5b' } });
        kaart.addLayer({ id: 'nucleair-site', type: 'circle', source: 'nucleair', filter: ['==', ['geometry-type'], 'Point'], paint: { 'circle-color': '#ffb020', 'circle-radius': 7, 'circle-stroke-color': '#000', 'circle-stroke-width': 2 } });
        kaart.on('click', 'nucleair-site', (e) => {
          const p = e.features![0].properties as any;
          new maplibregl.Popup({ maxWidth: '280px' }).setLngLat(e.lngLat)
            .setHTML(`<strong>${esc(p.naam ?? p.site)}</strong><br><span class="klein">${esc(p.soort ?? '')}</span><br><a href="/app/nucleair/">Zones en afstand</a>`).addTo(kaart);
        });
      } catch {
        return;
      }
    }
    for (const l of ['nucleair-uitbreiding', 'nucleair-schuilen', 'nucleair-evacuatie', 'nucleair-site']) kaart.setLayoutProperty(l, 'visibility', zichtbaar ? 'visible' : 'none');
  }

  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function toonPopup(e: maplibregl.MapLayerMouseEvent, laagNaam: string, id: string) {
    const f = e.features![0];
    const p = f.properties as Record<string, any>;
    const [osmType, osmId] = String(p.id ?? '').split('/');
    const regels = [
      `<strong>${esc(p.naam || laagNaam)}</strong>`,
      p.soort && `<span class="klein">${esc(p.soort)}</span>`,
      p.adres && esc(p.adres),
      p.emergency === 'ja' && '<span class="label officieel">spoed</span>',
      p.openingsuren && `Open: ${esc(p.openingsuren)}`,
      p.toegang && `Toegang: ${esc(p.toegang)}`,
      id === 'schuilplekken' && `<em class="klein">${esc(p.label || SCHUIL_LABEL)}</em>`,
      `<span class="label osm">OpenStreetMap</span>`,
      osmId && navigator.onLine && `<a class="klein" href="https://www.openstreetmap.org/${osmType}/${osmId}">bekijk of verbeter</a> · <a class="klein" href="https://www.openstreetmap.org/note/new#map=19/${e.lngLat.lat}/${e.lngLat.lng}">klopt niet</a>`,
    ].filter(Boolean);
    new maplibregl.Popup({ maxWidth: '280px' }).setLngLat((f.geometry as Point).coordinates as [number, number]).setHTML(regels.join('<br>')).addTo(kaart);
  }

  kaart.on('load', async () => {
    for (const v of vinkjes) await zetLaag(v.dataset.laag!, v.checked);
    if (vraag === 'nucleair') kaart.fitBounds([[2.0, 49.3], [6.5, 51.6]], { padding: 20 });
  });

  vinkjes.forEach((v) =>
    v.addEventListener('change', async () => {
      await zetLaag(v.dataset.laag!, v.checked);
      bewaar('kaartlagen', vinkjes.filter((x) => x.checked).map((x) => x.dataset.laag!));
    })
  );

  // Dichtstbijzijnde punten per actieve laag, offline berekend.
  let mijnMarker: maplibregl.Marker | null = null;
  document.getElementById('dichtstbij')!.addEventListener('click', async () => {
    const uit = document.getElementById('dichtst')!;
    uit.textContent = 'Positie zoeken…';
    const p = await positie();
    const lat = p?.coords.latitude ?? kaart.getCenter().lat;
    const lon = p?.coords.longitude ?? kaart.getCenter().lng;
    mijnMarker?.remove();
    mijnMarker = new maplibregl.Marker({ color: '#ffb020' }).setLngLat([lon, lat]).addTo(kaart);
    const blokken: string[] = [p ? '' : '<p>Geen gps; vanaf het midden van de kaart.</p>'];
    for (const v of vinkjes.filter((x) => x.checked && x.dataset.laag !== 'nucleair')) {
      const id = v.dataset.laag!;
      const def = LAGEN.find((l) => l.id === id)!;
      const fc = await laad(id).catch(() => null);
      if (!fc) continue;
      const top = fc.features
        .map((f) => {
          const [flon, flat] = (f.geometry as Point).coordinates;
          return { f, d: afstandKm(lat, lon, flat, flon), r: richting(lat, lon, flat, flon) };
        })
        .sort((a, b) => a.d - b.d)
        .slice(0, 3);
      blokken.push(`<strong>${def.naam}</strong><ol style="margin:.2rem 0 .6rem;padding-left:1.2rem">${top
        .map((t) => `<li>${esc((t.f.properties as any)?.naam || def.naam)} — ${km(t.d)} ${t.r.windstreek}</li>`)
        .join('')}</ol>`);
    }
    uit.innerHTML = blokken.join('');
    kaart.flyTo({ center: [lon, lat], zoom: Math.max(kaart.getZoom(), 13) });
  });
</script>

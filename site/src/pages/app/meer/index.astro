---
import App from '../../../layouts/App.astro';
const items = [
  ['/app/info/', 'Officiële informatie', 'BE-Alert, radio, crisiscentrum, 1771'],
  ['/app/nucleair/', 'Nucleair', 'Sites, zones, hoe ver woon ik'],
  ['/app/schuilen/', 'Schuilen', 'Keuzehulp per dreiging, eigen huis'],
  ['/app/eerste-hulp/', 'Eerste hulp', 'Stand van zaken en bronnen'],
  ['/app/voorraad/', 'Voorraadplanner', 'Water voor personen en dagen'],
  ['/app/checklists/', 'Checklists', 'Noodpakket, vluchttas, auto'],
  ['/app/noodplan/', 'Gezinsnoodplan', 'Invullen en afdrukken'],
  ['/app/signalen/', 'Signalen', 'SOS-lamp, morse, noodsignalen, radio'],
  ['/app/kompas/', 'Kompas', 'Richting zonder netwerk'],
  ['/app/notities/', 'Notities', 'Logboek op dit toestel'],
  ['/app/zoeken/', 'Zoeken', 'In alle teksten'],
  ['/app/pakket/', 'Instellingen en pakket', 'Offline zetten, weergave, opslag, batterij'],
  ['/app/over/', 'Over PlanB72', 'Bronnen, licenties, disclaimer'],
];
---
<App titel="Meer" tab="meer">
  <h1>Meer</h1>
  <div class="raster">
    {items.map(([href, t, u]) => (
      <a class="tegel" href={href}><strong>{t}</strong><span class="klein">{u}</span></a>
    ))}
  </div>
</App>

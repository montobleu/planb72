---
import App from '../../../layouts/App.astro';
const onderwerpen = ['Ernstige bloeding', 'Reanimatie en AED', 'Verslikking', 'Bewusteloosheid en stabiele zijligging', 'Brandwonden', 'Breuken en verstuikingen', 'Onderkoeling', 'Oververhitting', 'Shock', 'Vergiftiging en CO', 'Elektrocutie', 'Verdrinking', 'Wondverzorging', 'Allergische reactie', 'Beroerte en hartinfarct herkennen', "Baby's en kinderen", 'Noodbevalling'];
---
<App titel="Eerste hulp" tab="meer">
  <h1>Eerste hulp</h1>
  <div class="melding gevaar"><strong>Bel eerst <a href="tel:112">112</a>.</strong> De meldkamer begeleidt telefonisch, ook bij reanimatie.</div>
  <div class="concept">
    <strong>Nog niet beschikbaar in deze versie.</strong>
    PlanB72 schrijft geen eigen medisch advies. De eerste-hulpteksten komen uit erkende bronnen
    (Rode Kruis, Europese Reanimatieraad, WHO, Hesperian) en verschijnen pas na toestemming en nazicht door een zorgverlener.
  </div>
  <h2>Beschikbare alternatieven</h2>
  <ul>
    <li>De gratis <strong>EHBO-app van het Rode Kruis</strong> werkt offline. Installeer ze vooraf, zolang er een verbinding is.</li>
    <li>Volg een cursus eerste hulp bij <a href="https://www.rodekruis.be">Rode Kruis-Vlaanderen</a> of <a href="https://www.croix-rouge.be">Croix-Rouge de Belgique</a>.</li>
    <li>Op de <a href="/app/kaart/?laag=aed">kaart</a> staan de AED-toestellen uit OpenStreetMap.</li>
  </ul>
  <h2>Geplande onderwerpen</h2>
  <ul class="klein">{onderwerpen.map((o) => <li>{o}</li>)}</ul>
</App>

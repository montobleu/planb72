---
import App from '../../../layouts/App.astro';
import { getCollection } from 'astro:content';
const onderwerpen = (await getCollection('eerstehulp')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<App titel="Eerste hulp" tab="meer">
  <h1>Eerste hulp</h1>
  <div class="melding gevaar"><strong>Bel eerst <a href="tel:112">112</a>.</strong> De meldkamer begeleidt telefonisch, ook bij reanimatie. Antigifcentrum: <a href="tel:070245245">070 245 245</a>.</div>
  <div class="concept">
    <strong>Status: concept.</strong> Deze teksten zijn samengesteld uit de richtlijnen van het Rode Kruis, de European Resuscitation Council en andere erkende bronnen, en worden nagelezen door een zorgverlener. Een cursus eerste hulp blijft de beste voorbereiding.
  </div>
  {onderwerpen.length > 0 ? (
    <div class="raster" style="margin-top:1.5rem">
      {onderwerpen.map((o) => <a class="tegel" href={`/app/eerste-hulp/${o.id}/`}><strong>{o.data.titel}</strong><span class="klein">{o.data.kort}</span></a>)}
    </div>
  ) : <p>De onderwerpen worden samengesteld.</p>}
  <h2>Voorbereiden</h2>
  <ul>
    <li>Installeer de gratis EHBO-app van het Rode Kruis; die werkt offline.</li>
    <li>Volg een cursus bij <a href="https://www.rodekruis.be">Rode Kruis-Vlaanderen</a> of <a href="https://www.croix-rouge.be">Croix-Rouge de Belgique</a>.</li>
    <li>De AED-toestellen in de buurt staan op de <a href="/app/kaart/?laag=aed">kaart</a>.</li>
  </ul>
</App>

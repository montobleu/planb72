---
import App from '../../../layouts/App.astro';
---
<App taal="nl" titel="Route" tab="kaart" volledig>
  <main id="inhoud" class="kaart-pagina route-pagina">
    <h1 class="sr-only">Route plannen</h1>
    <div id="kaart" role="region" aria-label="Kaart voor de route. Lang drukken of rechtsklikken kiest A of B."></div>
    <div id="vizier" class="vizier" hidden aria-hidden="true"></div>
    <div class="kaart-paneel route-paneel niet-afdrukken">
      <details id="paneel" open>
        <summary class="paneel-kop">Route plannen</summary>

        <!-- 1. Wat er nu op de kaart staat: één toestand tegelijk. -->
        <section id="status" class="status" data-toestand="leeg" aria-labelledby="status-titel">
          <p id="status-titel" class="status-titel">Kies een vertrekpunt en een bestemming</p>
          <p id="status-tekst" class="status-tekst"></p>
          <progress id="laden" hidden aria-label="Bezig"></progress>
          <div id="status-acties" class="status-acties"></div>
        </section>

        <form id="routeform" novalidate>
          <!-- 2. Vervoerswijze -->
          <fieldset class="modi">
            <legend class="blok-kop">Vervoerswijze</legend>
            <div class="modi-knoppen">
              <label><input type="radio" name="modus" value="voet" checked />Te voet</label>
              <label><input type="radio" name="modus" value="fiets" />Fiets</label>
              <label><input type="radio" name="modus" value="auto" />Auto</label>
            </div>
          </fieldset>

          <!-- 3. Vertrekpunt en bestemming -->
          {(['a', 'b'] as const).map((k) => (
            <section class={`punt punt-${k}`} aria-labelledby={`kop-${k}`}>
              <div class="punt-kop">
                <span class={`badge ${k}`} aria-hidden="true">{k.toUpperCase()}</span>
                <h2 id={`kop-${k}`}>{k === 'a' ? 'Vertrekpunt' : 'Bestemming'}</h2>
              </div>
              <p class="gekozen-vak" id={`gekozen-${k}`} data-gekozen={k} data-leeg>Nog niet gekozen</p>
              <label class="sr-only" for={`zoek-${k}`}>{k === 'a' ? 'Vertrekpunt zoeken' : 'Bestemming zoeken'}</label>
              <search>
                <input id={`zoek-${k}`} type="search" autocomplete="off" spellcheck="false"
                  placeholder="Zoek plaats, straat, ziekenhuis…"
                  aria-describedby={`gekozen-${k}`} aria-controls={`treffers-${k}`} />
              </search>
              <ul id={`treffers-${k}`} class="treffers" hidden aria-label={k === 'a' ? 'Zoekresultaten voor het vertrekpunt' : 'Zoekresultaten voor de bestemming'}></ul>
              <div class="punt-acties">
                <button type="button" class="knop klein-knop" data-kies={k}>Kies op de kaart</button>
                <button type="button" class="knop klein-knop" data-midden={k}>Midden van de kaart</button>
                {k === 'a' && <button type="button" class="knop klein-knop" id="mijn-positie" hidden>Mijn laatst bekende positie</button>}
              </div>
            </section>
          ))}

          <div class="wissel-rij">
            <button type="button" class="tekstknop" id="wissel">A en B wisselen</button>
            <button type="button" class="tekstknop" id="wis">Alles wissen</button>
          </div>
        </form>

        <!-- 4. Aanwijzingen -->
        <section id="uitkomst" class="uitkomst" hidden aria-labelledby="aanwijzingen-kop">
          <h2 id="aanwijzingen-kop" class="blok-kop">Aanwijzingen</h2>
          <ol id="stappen" class="aanwijzingen"></ol>
          <p id="technisch" class="toelichting"></p>
        </section>

        <!-- 5. Toelichting -->
        <div class="paneel-voet">
          <details class="instellingen">
            <summary>Instellingen</summary>
            <label class="vink"><input type="checkbox" id="positieknop" /> Knop tonen om mijn laatst bekende positie als vertrekpunt te gebruiken</label>
            <p class="toelichting">Uit: PlanB72 vraagt nooit je positie. Aan: alleen als je op de knop tikt, één keer, zonder je te volgen.</p>
          </details>
          <p id="kaart-status" class="toelichting" hidden></p>
          <p class="toelichting">Routes worden op dit toestel berekend uit OpenStreetMap, ook zonder internet, als het routepakket van de regio gedownload is.</p>
          <p class="toelichting"><a href="/app/pakket/#routes-kop">Routepakketten</a> · <a href="/app/kaart/">Kaart</a></p>
        </div>
      </details>
      <p id="melding" class="sr-only" role="status"></p>
    </div>

    <section id="afdruk" class="alleen-afdruk" aria-labelledby="afdruk-kop">
      <h2 id="afdruk-kop">Route</h2>
      <p id="afdruk-punten"></p>
      <p id="afdruk-samenvatting"></p>
      <img id="afdruk-kaart" alt="" />
      <ol id="afdruk-stappen" class="aanwijzingen"></ol>
      <p class="klein">PlanB72 · berekend zonder internet uit OpenStreetMap (© OpenStreetMap-bijdragers, ODbL).</p>
    </section>
  </main>
</App>

<style is:global>
  /* Kleuren van A en B: dezelfde als de markeringen op de kaart. Wit op beide vlakken >= 4.5:1. */
  .route-pagina {
    --kleur-a: #1d6b40;
    --kleur-b: #b42318;
    --rand-a: light-dark(#1d6b40, #4fae78);
    --rand-b: light-dark(#b42318, #f0605d);
    --let-op: light-dark(#8a5a00, #f0b429);
    --let-op-bg: light-dark(#fff7e6, #2a2112);
  }
  .route-paneel {
    width: min(24rem, calc(100% - 20px)); max-width: none; padding: 0;
    border-color: var(--rand-sterk); box-shadow: 0 4px 18px rgb(0 0 0 / 0.22); font-size: 0.95rem;
  }
  .route-paneel > details > :not(summary) { margin-inline: 16px; }
  .route-paneel .paneel-kop {
    font-size: 1.1rem; font-weight: 700; padding: 12px 16px; min-height: 48px;
    border-bottom: 1px solid var(--rand); position: sticky; top: 0; background: var(--bg); z-index: 1;
  }
  .route-paneel h2 { font-size: 1rem; font-weight: 700; margin: 0; }
  .blok-kop { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tekst-2); margin: 0 0 6px; padding: 0; }
  .toelichting { font-size: 0.875rem; color: var(--tekst-2); margin: 0.5rem 0; line-height: 1.45; }

  /* Status */
  .status { margin-block: 14px; padding: 12px 14px; border-radius: var(--radius); background: var(--bg-2); border: 1px solid var(--rand); border-left: 4px solid var(--rand-sterk); }
  .status-titel { font-weight: 700; font-size: 1.05rem; margin: 0; color: var(--tekst); }
  .status-tekst { margin: 6px 0 0; color: var(--tekst); line-height: 1.45; }
  .status-tekst:empty { display: none; }
  .status[data-toestand="route"] { border-left-color: var(--ok); }
  .status[data-toestand="route"] .status-titel { font-size: 1.4rem; font-variant-numeric: tabular-nums; }
  .status[data-toestand="vogelvlucht"], .status[data-toestand="fout"] { border-left-color: var(--let-op); background: var(--let-op-bg); }
  .status-acties { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .status-acties:empty { display: none; }
  .status progress { width: 100%; margin-top: 8px; }

  /* Vervoerswijze als drie knoppen */
  .route-paneel fieldset.modi { border: 0; padding: 0; margin: 0 0 14px; }
  .modi-knoppen { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--rand-sterk); border-radius: var(--radius); overflow: hidden; }
  .route-paneel .modi-knoppen label { position: relative; display: flex; justify-content: center; align-items: center; min-height: 44px; margin: 0; font-weight: 600; cursor: pointer; color: var(--tekst); }
  .modi-knoppen label + label { border-left: 1px solid var(--rand-sterk); }
  .modi-knoppen input { appearance: none; position: absolute; inset: 0; margin: 0; cursor: pointer; }
  .modi-knoppen label:has(input:checked) { background: var(--merk); color: var(--merk-tekst); }
  .modi-knoppen label:has(input:focus-visible) { outline: 3px solid var(--merk); outline-offset: -5px; box-shadow: inset 0 0 0 4px var(--bg); }

  /* Vertrekpunt en bestemming */
  .punt { border: 1px solid var(--rand); border-left: 4px solid var(--rand-a); border-radius: var(--radius); padding: 10px 12px; margin: 0 0 10px; background: var(--bg); }
  .punt-b { border-left-color: var(--rand-b); }
  .punt-kop { display: flex; align-items: center; gap: 10px; }
  .badge { flex: none; width: 26px; height: 26px; border-radius: 50%; display: inline-grid; place-items: center; font-weight: 700; font-size: 0.9rem; color: #fff; background: var(--kleur-a); }
  .badge.b { background: var(--kleur-b); }
  .gekozen-vak { margin: 8px 0; font-weight: 600; color: var(--tekst); line-height: 1.35; }
  .gekozen-vak[data-leeg] { font-weight: 400; color: var(--tekst-2); }
  .route-paneel input[type="search"] { min-height: 44px; padding: 8px 12px; }
  .punt-acties { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .knop.klein-knop { min-height: 38px; padding: 0 12px; font-size: 0.875rem; }
  .knop.klein-knop[aria-pressed="true"] { background: var(--merk); color: var(--merk-tekst); border-color: var(--merk); }
  .wissel-rij { display: flex; justify-content: space-between; gap: 8px; margin: 2px 0 6px; }
  /* Aanraakscherm: doelen van minstens 44 px (WCAG 2.5.5). */
  @media (pointer: coarse) { .knop.klein-knop, .tekstknop { min-height: 44px; } }
  .tekstknop { background: none; border: 0; padding: 8px 2px; min-height: 40px; font: inherit; font-size: 0.9rem; color: var(--link); text-decoration: underline; text-underline-offset: 0.18em; cursor: pointer; }

  .treffers { list-style: none; margin: 4px 0; padding: 0; border: 1px solid var(--rand-sterk); border-radius: var(--radius); max-height: 16rem; overflow: auto; background: var(--bg); }
  .treffers li + li { border-top: 1px solid var(--rand); }
  .treffers button { display: block; width: 100%; text-align: left; background: var(--bg); color: var(--tekst); border: 0; padding: 8px 10px; font: inherit; cursor: pointer; min-height: 44px; }
  .treffers button:hover, .treffers button:focus-visible { background: var(--bg-2); }
  .treffers .klein { display: block; }

  /* Aanwijzingen */
  .uitkomst { border-top: 1px solid var(--rand); padding-top: 12px; margin-top: 6px; }
  .aanwijzingen { margin: 0; padding-left: 1.7rem; }
  .aanwijzingen li { padding: 6px 0; border-bottom: 1px solid var(--rand); }
  .aanwijzingen li::marker { color: var(--tekst-2); font-variant-numeric: tabular-nums; }
  .aanwijzingen button { all: unset; cursor: pointer; display: block; width: 100%; line-height: 1.4; }
  .aanwijzingen button:focus-visible { outline: 2px solid var(--merk); outline-offset: 2px; }
  .aanwijzingen .afstand { display: block; color: var(--tekst-2); font-size: 0.85rem; font-variant-numeric: tabular-nums; }

  .paneel-voet { border-top: 1px solid var(--rand); margin-top: 12px; padding: 4px 0 12px; }
  .route-paneel .instellingen { margin: 6px 0; }
  .route-paneel .instellingen summary { font-weight: 600; font-size: 0.9rem; min-height: 40px; }
  .route-paneel label.vink { align-items: flex-start; font-weight: 400; }
  .route-paneel :focus-visible { outline: 2px solid var(--merk); outline-offset: 2px; }
  .route-paneel [hidden] { display: none !important; }
  #kaart:has(canvas:focus-visible) { outline: 3px solid var(--merk); outline-offset: -3px; }
  .vizier { position: absolute; left: 50%; top: 50%; width: 28px; height: 28px; margin: -14px 0 0 -14px; pointer-events: none; z-index: 4; }
  .vizier::before, .vizier::after { content: ""; position: absolute; background: var(--tekst); }
  .vizier::before { left: 13px; top: 0; width: 2px; height: 28px; }
  .vizier::after { top: 13px; left: 0; height: 2px; width: 28px; }
  .markering { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-family: var(--font); color: #fff; border: 2px solid #fff; box-shadow: 0 1px 4px #0008; cursor: grab; }
  .markering.a { background: #1d6b40; }
  .markering.b { background: #b42318; }
  .keuze-popup { display: flex; flex-direction: column; gap: 6px; }
  .alleen-afdruk { display: none; }
  @media (max-width: 640px) {
    .route-paneel { top: auto; bottom: 10px; max-height: 62%; }
  }
  @media (forced-colors: active) {
    .modi-knoppen label:has(input:checked) { forced-color-adjust: none; background: Highlight; color: HighlightText; }
    .status, .punt { border: 1px solid CanvasText; border-left-width: 4px; }
  }
  @media print {
    .route-pagina { position: static; }
    .route-pagina #kaart, .route-pagina .vizier, .maplibregl-control-container { display: none !important; }
    .alleen-afdruk { display: block; }
    #afdruk-kaart { max-width: 100%; max-height: 10cm; border: 1px solid #999; }
    #afdruk-kaart:not([src]) { display: none; }
    .aanwijzingen li { break-inside: avoid; }
  }
</style>

<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import * as maplibregl from 'maplibre-gl';
  import { volgStraatniveau } from '../../../lib/straatniveau';
  import { basiskaart, herlaadBijKleurwissel, kaartfoutTekst } from '../../../lib/basiskaart';
  import { routeOverzicht, routesOpToestel, downloadRoute, type Routepakket } from '../../../lib/routepakketten';
  import { lees, bewaar, km, vraagBlijvendeOpslag, afstandKm, richting } from '../../../lib/app';
  import { mb } from '../../../lib/kaarten';
  import type { Modus, Punt, Route } from '../../../lib/route';
  import type { Treffer } from '../../../lib/route.worker';

  type Gekozen = Punt & { naam: string };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const melding = $('#melding');
  const laden = $<HTMLProgressElement>('#laden');
  const statusDoos = $('#status');

  /** Eén duidelijke toestand bovenaan het paneel; de schermlezer hoort dezelfde tekst. */
  type Toestand = 'leeg' | 'half' | 'kiezen' | 'rekenen' | 'route' | 'vogelvlucht' | 'fout';
  function toonStatus(toestand: Toestand, titel: string, tekst = '', acties: HTMLElement[] = []) {
    statusDoos.dataset.toestand = toestand;
    $('#status-titel').textContent = titel;
    $('#status-tekst').textContent = tekst;
    $('#status-acties').replaceChildren(...acties);
    laden.hidden = toestand !== 'rekenen';
    melding.textContent = [titel, tekst].filter(Boolean).join('. ');
  }
  function knop(tekst: string, klik: () => void, hoofd = false) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = `knop klein-knop${hoofd ? ' hoofd' : ''}`;
    b.textContent = tekst;
    b.addEventListener('click', klik);
    return b;
  }
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const MODUS_NAAM: Record<Modus, string> = { voet: 'te voet', fiets: 'met de fiets', auto: 'met de auto' };

  if (matchMedia('(max-width: 640px)').matches && lees('route-paneel-dicht', false)) $<HTMLDetailsElement>('#paneel').open = false;
  $<HTMLDetailsElement>('#paneel').addEventListener('toggle', (e) => bewaar('route-paneel-dicht', !(e.target as HTMLDetailsElement).open));

  // ---------- Kaart ----------
  herlaadBijKleurwissel();
  const basis = await basiskaart();
  if (basis.melding) { $('#kaart-status').textContent = basis.melding; $('#kaart-status').hidden = false; }
  const bewaardBeeld = lees<{ c: [number, number]; z: number } | null>('kaartbeeld', null);
  const kaart = new maplibregl.Map({
    container: 'kaart',
    style: basis.stijl,
    center: bewaardBeeld?.c ?? [4.47, 50.64],
    zoom: bewaardBeeld?.z ?? 7,
    maxZoom: 18,
    attributionControl: { compact: true },
    fadeDuration: 0,
  });
  (window as any).__kaart = kaart;
  // Met verbinding: regio's op straatniveau (met straatnamen) laden zodra ze in beeld komen.
  volgStraatniveau(kaart, { pakketten: basis.pakketten, aanwezig: new Set(basis.zichtbaar.map((p) => p.id)), licht: basis.licht, taal: 'nl' });
  kaart.on('error', (e) => {
    console.error('Kaartfout', e.error);
    $('#kaart-status').textContent = kaartfoutTekst(e.error, basis.lokaal);
    $('#kaart-status').hidden = false;
  });
  kaart.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  kaart.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-right');
  const routeKleur = basis.licht ? '#12385c' : '#9cc3e8';
  kaart.on('load', () => {
    kaart.addSource('route', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    kaart.addLayer({ id: 'route-rand', type: 'line', source: 'route', layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': basis.licht ? '#ffffff' : '#0e1318', 'line-width': ['interpolate', ['linear'], ['zoom'], 8, 5, 16, 11] } });
    kaart.addLayer({ id: 'route-lijn', type: 'line', source: 'route', layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': routeKleur, 'line-width': ['interpolate', ['linear'], ['zoom'], 8, 3, 16, 7] } });
    // Zonder route: een rechte stippellijn tussen A en B, met de afstand in vogelvlucht.
    kaart.addSource('vogelvlucht', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    kaart.addLayer({ id: 'vogelvlucht-lijn', type: 'line', source: 'vogelvlucht', filter: ['==', ['geometry-type'], 'LineString'],
      paint: { 'line-color': routeKleur, 'line-width': 3, 'line-dasharray': [2, 2] } });
    kaart.addLayer({ id: 'vogelvlucht-label', type: 'symbol', source: 'vogelvlucht', filter: ['==', ['geometry-type'], 'Point'],
      layout: { 'text-field': ['get', 'label'], 'text-allow-overlap': true, 'text-max-width': 30, 'text-font': ['Noto Sans Medium'], 'text-size': 14, 'text-offset': [0, -1] },
      paint: { 'text-color': basis.licht ? '#0f1a24' : '#e8edf2', 'text-halo-color': basis.licht ? '#ffffff' : '#0e1318', 'text-halo-width': 2 } });
    if (laatsteRoute) tekenRoute(laatsteRoute);
    if (laatsteVogelvlucht) tekenVogelvlucht(laatsteVogelvlucht);
  });

  // ---------- Rekenwerk in een Web Worker ----------
  const werker = new Worker(new URL('../../../lib/route.worker.ts', import.meta.url), { type: 'module' });
  let vraagNr = 0;
  const wachtend = new Map<number, { ok: (v: any) => void; nee: (e: Error) => void }>();
  werker.onmessage = (ev) => {
    const d = ev.data;
    if (d.soort === 'voortgang') { if (statusDoos.dataset.toestand === 'rekenen') $('#status-tekst').textContent = d.tekst; return; }
    const w = wachtend.get(d.nr);
    if (!w) return;
    wachtend.delete(d.nr);
    if (d.soort === 'fout') w.nee(new Error(d.tekst)); else w.ok(d);
  };
  function vraag<T>(bericht: Record<string, unknown>): Promise<T> {
    const nr = ++vraagNr;
    return new Promise((ok, nee) => { wachtend.set(nr, { ok, nee }); werker.postMessage({ ...bericht, nr }); });
  }

  let overzicht: Routepakket[] = [];
  let opToestel = new Map<string, Blob>();
  async function meldPakketten() {
    overzicht = await routeOverzicht();
    opToestel = await routesOpToestel();
    werker.postMessage({
      soort: 'pakketten',
      pakketten: overzicht.filter((p) => opToestel.has(p.id)).map((p) => ({ id: p.id, bbox: p.bbox, bestand: opToestel.get(p.id) })),
    });
  }
  await meldPakketten();

  // ---------- Punten A en B ----------
  const punten: Record<'a' | 'b', Gekozen | null> = { a: null, b: null };
  const markers: Record<'a' | 'b', maplibregl.Marker | null> = { a: null, b: null };
  let modus: Modus = 'voet';
  let laatsteRoute: Route | null = null;
  let laatsteVogelvlucht: [Punt, Punt] | null = null;

  const graden = (p: Punt) => `${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}`;

  function zetPunt(k: 'a' | 'b', p: Gekozen | null, { vlieg = false, rekenen = true } = {}) {
    punten[k] = p;
    markers[k]?.remove();
    markers[k] = null;
    const uitleg = $(`[data-gekozen="${k}"]`);
    uitleg.toggleAttribute('data-leeg', !p);
    if (p) {
      const el = document.createElement('div');
      el.className = `markering ${k}`;
      el.textContent = k.toUpperCase();
      el.setAttribute('aria-hidden', 'true');
      const m = new maplibregl.Marker({ element: el, draggable: true }).setLngLat([p.lon, p.lat]).addTo(kaart);
      m.on('dragend', () => {
        const ll = m.getLngLat();
        zetPunt(k, { lon: ll.lng, lat: ll.lat, naam: `Punt op de kaart (${graden({ lon: ll.lng, lat: ll.lat })})` });
      });
      markers[k] = m;
      uitleg.textContent = p.naam;
      if (vlieg) kaart.flyTo({ center: [p.lon, p.lat], zoom: Math.max(kaart.getZoom(), 14) });
    } else uitleg.textContent = 'Nog niet gekozen.';
    bewaar('route-punten', punten);
    if (rekenen) rekenUit();
  }

  // Kiezen op de kaart: één tik na "Kies op de kaart", of lang drukken / rechtsklikken.
  let kiesModus: 'a' | 'b' | null = null;
  const kiesKnoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-kies]')];
  kiesKnoppen.forEach((b) => b.setAttribute('aria-pressed', 'false'));
  function zetKiesModus(k: 'a' | 'b' | null) {
    kiesModus = k;
    kiesKnoppen.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kies === k)));
    kaart.getCanvas().style.cursor = k ? 'crosshair' : '';
    if (k) toonStatus('kiezen', `Tik op de kaart om ${k === 'a' ? 'het vertrekpunt (A)' : 'de bestemming (B)'} te kiezen`,
      'Of druk lang op de kaart. Tik nog eens op de knop om te annuleren.');
    else if (statusDoos.dataset.toestand === 'kiezen') toonBasisStatus();
  }
  kiesKnoppen.forEach((b) => b.addEventListener('click', () => zetKiesModus(kiesModus === b.dataset.kies ? null : (b.dataset.kies as 'a' | 'b'))));
  kaart.on('click', (e) => {
    if (!kiesModus) return;
    const k = kiesModus;
    zetKiesModus(null);
    zetPunt(k, { lon: e.lngLat.lng, lat: e.lngLat.lat, naam: `Punt op de kaart (${graden({ lon: e.lngLat.lng, lat: e.lngLat.lat })})` });
  });

  let keuzePopup: maplibregl.Popup | null = null;
  function toonKeuze(ll: maplibregl.LngLat) {
    keuzePopup?.remove();
    const doos = document.createElement('div');
    doos.className = 'keuze-popup';
    for (const k of ['a', 'b'] as const) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'knop klein-knop';
      b.textContent = k === 'a' ? 'Vertrek hier (A)' : 'Bestemming hier (B)';
      b.addEventListener('click', () => {
        keuzePopup?.remove();
        zetPunt(k, { lon: ll.lng, lat: ll.lat, naam: `Punt op de kaart (${graden({ lon: ll.lng, lat: ll.lat })})` });
      });
      doos.append(b);
    }
    keuzePopup = new maplibregl.Popup({ maxWidth: '240px', focusAfterOpen: true }).setLngLat(ll).setDOMContent(doos).addTo(kaart);
  }
  kaart.on('contextmenu', (e) => toonKeuze(e.lngLat));
  let drukTimer = 0;
  kaart.on('touchstart', (e) => {
    if (e.originalEvent.touches.length !== 1) return;
    const ll = e.lngLat;
    clearTimeout(drukTimer);
    drukTimer = window.setTimeout(() => toonKeuze(ll), 550);
  });
  for (const ev of ['touchend', 'touchmove', 'touchcancel', 'movestart'] as const) kaart.on(ev, () => clearTimeout(drukTimer));

  // Met het toetsenbord: kaart verschuiven met de pijltjes, dan "Midden van de kaart".
  const vizier = $('#vizier');
  const kaartEl = $('#kaart');
  kaartEl.addEventListener('focusin', () => (vizier.hidden = false));
  kaartEl.addEventListener('focusout', () => (vizier.hidden = true));
  document.querySelectorAll<HTMLButtonElement>('[data-midden]').forEach((b) =>
    b.addEventListener('click', () => {
      const c = kaart.getCenter();
      zetPunt(b.dataset.midden as 'a' | 'b', { lon: c.lng, lat: c.lat, naam: `Midden van de kaart (${graden({ lon: c.lng, lat: c.lat })})` });
    })
  );

  // Optioneel: laatst bekende positie, één keer opgevraagd, standaard uit.
  const positieVink = $<HTMLInputElement>('#positieknop');
  const positieKnop = $<HTMLButtonElement>('#mijn-positie');
  positieVink.checked = lees('route-positieknop', false);
  positieKnop.hidden = !positieVink.checked;
  positieVink.addEventListener('change', () => { bewaar('route-positieknop', positieVink.checked); positieKnop.hidden = !positieVink.checked; });
  positieKnop.addEventListener('click', () => {
    if (!('geolocation' in navigator)) { toonStatus('fout', 'Dit toestel geeft geen positie', 'Kies het vertrekpunt op de kaart of zoek een plaats.'); return; }
    toonStatus('rekenen', 'Laatst bekende positie opvragen');
    navigator.geolocation.getCurrentPosition(
      (p) => zetPunt('a', { lon: p.coords.longitude, lat: p.coords.latitude, naam: 'Mijn laatst bekende positie' }, { vlieg: true }),
      () => toonStatus('fout', 'Geen positie beschikbaar', 'Kies het vertrekpunt op de kaart of zoek een plaats.'),
      { enableHighAccuracy: false, maximumAge: Infinity, timeout: 15000 }
    );
  });

  // ---------- Zoeken ----------
  let zoekTimer = 0;
  let meldTimer = 0;
  for (const k of ['a', 'b'] as const) {
    const veld = $<HTMLInputElement>(`#zoek-${k}`);
    const lijst = $<HTMLUListElement>(`#treffers-${k}`);
    let treffers: Treffer[] = [];
    const kies = (t: Treffer) => {
      lijst.hidden = true;
      veld.value = '';
      zetPunt(k, { lon: t.lon, lat: t.lat, naam: t.context ? `${t.naam}, ${t.context}` : t.naam }, { vlieg: true });
      veld.focus();
    };
    veld.addEventListener('input', () => {
      clearTimeout(zoekTimer);
      const tekst = veld.value.trim();
      if (tekst.length < 2) { lijst.hidden = true; lijst.replaceChildren(); return; }
      zoekTimer = window.setTimeout(async () => {
        const c = kaart.getCenter();
        try {
          const uit = await vraag<{ treffers: Treffer[] }>({ soort: 'zoek', tekst, nabij: { lon: c.lng, lat: c.lat } });
          if (veld.value.trim() !== tekst) return;
          treffers = uit.treffers;
          lijst.replaceChildren(...treffers.map((t) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.innerHTML = `<strong>${esc(t.naam)}</strong><span class="klein">${esc([t.soort, t.context].filter(Boolean).join(' · '))}</span>`;
            b.addEventListener('click', () => kies(t));
            b.addEventListener('keydown', (e) => {
              const knoppen = [...lijst.querySelectorAll('button')];
              const i = knoppen.indexOf(b);
              if (e.key === 'ArrowDown') { e.preventDefault(); knoppen[i + 1]?.focus(); }
              if (e.key === 'ArrowUp') { e.preventDefault(); (knoppen[i - 1] ?? veld).focus(); }
              if (e.key === 'Escape') { lijst.hidden = true; veld.focus(); }
            });
            li.append(b);
            return li;
          }));
          lijst.hidden = !treffers.length;
          // Aantal resultaten pas na een korte pauze melden, zodat een schermlezer niet bij elke toets praat.
          clearTimeout(meldTimer);
          meldTimer = window.setTimeout(() => {
            melding.textContent = treffers.length
              ? `${treffers.length} resultaten. Pijl omlaag om te kiezen.`
              : opToestel.size ? 'Niets gevonden in de routepakketten op dit toestel.' : 'Niets gevonden. Download een routepakket om op straat en plaats te zoeken.';
          }, 700);
        } catch (e) {
          toonStatus('fout', 'Zoeken lukt niet', (e as Error).message);
        }
      }, 180);
    });
    veld.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && !lijst.hidden) { e.preventDefault(); lijst.querySelector('button')?.focus(); }
      if (e.key === 'Enter') { e.preventDefault(); if (treffers[0] && !lijst.hidden) kies(treffers[0]); }
      if (e.key === 'Escape') lijst.hidden = true;
    });
  }
  $('#routeform').addEventListener('submit', (e) => e.preventDefault());

  // ---------- Vervoerswijze, wisselen, wissen ----------
  const modusVelden = [...document.querySelectorAll<HTMLInputElement>('input[name="modus"]')];
  modus = lees<Modus>('route-modus', 'voet');
  modusVelden.forEach((v) => {
    v.checked = v.value === modus;
    v.addEventListener('change', () => { modus = v.value as Modus; bewaar('route-modus', modus); rekenUit(); });
  });
  $('#wissel').addEventListener('click', () => {
    const { a, b } = punten;
    zetPunt('a', b, { rekenen: false });
    zetPunt('b', a);
  });
  $('#wis').addEventListener('click', () => {
    zetPunt('a', null, { rekenen: false });
    zetPunt('b', null, { rekenen: false });
    wisRoute();
    toonBasisStatus();
    melding.textContent = 'Vertrekpunt en bestemming gewist.';
  });

  // ---------- Route ----------
  function duur(s: number) {
    const min = Math.max(1, Math.round(s / 60));
    if (min < 60) return `${min} min`;
    return `${Math.floor(min / 60)} u ${String(min % 60).padStart(2, '0')} min`;
  }

  const LEGE_DATA = { type: 'FeatureCollection' as const, features: [] };
  function wisRoute() {
    laatsteRoute = null;
    laatsteVogelvlucht = null;
    $('#uitkomst').hidden = true;
    (kaart.getSource('route') as maplibregl.GeoJSONSource | undefined)?.setData(LEGE_DATA);
    (kaart.getSource('vogelvlucht') as maplibregl.GeoJSONSource | undefined)?.setData(LEGE_DATA);
  }

  function tekenRoute(r: Route) {
    (kaart.getSource('route') as maplibregl.GeoJSONSource | undefined)?.setData({
      type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: r.lijn },
    });
  }

  const WINDSTREEK: Record<string, string> = { N: 'noord', NO: 'noordoost', O: 'oost', ZO: 'zuidoost', Z: 'zuid', ZW: 'zuidwest', W: 'west', NW: 'noordwest' };
  function vogelvlucht(a: Punt, b: Punt) {
    const d = afstandKm(a.lat, a.lon, b.lat, b.lon);
    return { afstand: km(d), richting: WINDSTREEK[richting(a.lat, a.lon, b.lat, b.lon).windstreek] };
  }
  function tekenVogelvlucht([a, b]: [Punt, Punt]) {
    // Lijn en één label in het midden (een label langs de lijn zou per kaarttegel herhaald worden).
    (kaart.getSource('vogelvlucht') as maplibregl.GeoJSONSource | undefined)?.setData({
      type: 'FeatureCollection',
      features: [
        { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: [[a.lon, a.lat], [b.lon, b.lat]] } },
        { type: 'Feature', properties: { label: `${vogelvlucht(a, b).afstand} in vogelvlucht, geen route` },
          geometry: { type: 'Point', coordinates: [(a.lon + b.lon) / 2, (a.lat + b.lat) / 2] } },
      ],
    });
  }

  /** Breng een lijn (route of vogelvlucht) in beeld naast het paneel. */
  function toonInBeeld(lijn: [number, number][]) {
    const b = new maplibregl.LngLatBounds();
    for (const p of lijn) b.extend(p);
    const paneel = document.querySelector('.route-paneel') as HTMLElement;
    const smal = matchMedia('(max-width: 640px)').matches;
    kaart.fitBounds(b, {
      padding: smal ? { top: 50, bottom: Math.min(paneel.offsetHeight + 30, innerHeight * 0.6), left: 40, right: 40 }
        : { top: 60, bottom: 60, left: Math.min(paneel.offsetWidth + 50, innerWidth / 2), right: 70 },
      maxZoom: 16,
    });
  }

  /** De toestand zonder (volledige) route: wat moet de gebruiker nog doen? */
  function toonBasisStatus() {
    const { a, b } = punten;
    const geenPakket = !opToestel.size
      ? 'Er staat nog geen routepakket op dit toestel. Zonder pakket toont de kaart alleen A, B en de afstand in vogelvlucht.'
      : '';
    if (!a && !b) {
      toonStatus('leeg', 'Kies een vertrekpunt en een bestemming',
        `Zoek een plaats of straat, tik op "Kies op de kaart" of druk lang op de kaart. ${geenPakket}`.trim());
    } else if (!b) {
      toonStatus('half', 'Kies nog een bestemming (B)', geenPakket);
    } else if (!a) {
      toonStatus('half', 'Kies nog een vertrekpunt (A)', geenPakket);
    }
  }

  let rekenNr = 0;
  async function rekenUit() {
    const { a, b } = punten;
    if (!a || !b) { wisRoute(); toonBasisStatus(); return; }
    const nr = ++rekenNr;
    toonStatus('rekenen', 'Route berekenen', 'Op dit toestel, zonder internet.');
    try {
      const uit = await vraag<{ route: Route; laadtijd: number; regios: string[]; knopen: number }>({ soort: 'route', van: a, naar: b, modus });
      if (nr !== rekenNr) return;
      toonRoute(uit.route, uit);
    } catch (e) {
      if (nr !== rekenNr) return;
      toonZonderRoute(a, b, (e as Error).message);
    }
  }

  const binnen = (p: Punt, b: number[]) => p.lon >= b[0] && p.lon <= b[2] && p.lat >= b[1] && p.lat <= b[3];

  /** Geen route: A en B met een stippellijn, en zeggen wat er nodig is voor een echte route. */
  function toonZonderRoute(a: Gekozen, b: Gekozen, fout: string) {
    wisRoute();
    laatsteVogelvlucht = [a, b];
    tekenVogelvlucht([a, b]);
    toonInBeeld([[a.lon, a.lat], [b.lon, b.lat]]);
    const v = vogelvlucht(a, b);
    const vv = `In vogelvlucht ${v.afstand} richting ${v.richting}; de stippellijn op de kaart is geen route.`;
    const buiten = [a, b].filter((p) => !overzicht.some((o) => opToestel.has(o.id) && binnen(p, o.bbox)));
    if (!buiten.length) {
      // Pakketten zijn er, maar er is geen weg of verbinding gevonden.
      toonStatus('fout', 'Geen route gevonden', `${fout} ${vv}`);
      return;
    }
    const nodig = overzicht.filter((o) => !opToestel.has(o.id) && buiten.some((p) => binnen(p, o.bbox)));
    if (!nodig.length) {
      toonStatus('vogelvlucht', 'Geen route: dit gebied heeft nog geen routepakket', vv);
      return;
    }
    // Per punt één regio aanbieden (de kleinste die het punt bevat).
    const opp = (o: Routepakket) => (o.bbox[2] - o.bbox[0]) * (o.bbox[3] - o.bbox[1]);
    const aanbod = [...new Set(buiten.map((p) => nodig.filter((o) => binnen(p, o.bbox)).sort((x, y) => opp(x) - opp(y))[0]).filter(Boolean))];
    const namen = aanbod.map((o) => o.naam).join(' en ');
    const tekst = `Voor een route langs de wegen is het routepakket ${namen} nodig. ${vv}`;
    if (!navigator.onLine) {
      toonStatus('vogelvlucht', 'Geen route: routepakket ontbreekt', `${tekst} Download het pakket zodra je verbinding hebt.`);
      return;
    }
    const knoppen = aanbod.map((o) => knop(`${o.naam} downloaden (${mb(o.bytes)})`, () => downloadPakket(o), true));
    toonStatus('vogelvlucht', 'Geen route: routepakket ontbreekt', tekst, knoppen);
  }

  async function downloadPakket(o: Routepakket) {
    if (!navigator.onLine) { toonStatus('fout', 'Geen verbinding', 'Download het pakket later, hier of in Instellingen.'); return; }
    await vraagBlijvendeOpslag();
    toonStatus('rekenen', `${o.naam} downloaden`, `${mb(o.bytes)}. Daarna werkt de route ook zonder internet.`);
    laden.removeAttribute('value');
    try {
      await downloadRoute(o, (f) => (laden.value = f));
      await meldPakketten();
      melding.textContent = `Routepakket ${o.naam} staat op dit toestel.`;
      rekenUit();
    } catch {
      toonStatus('fout', `Download van ${o.naam} mislukt`, 'Controleer de verbinding en probeer opnieuw.', [knop('Opnieuw proberen', () => downloadPakket(o), true)]);
    } finally {
      laden.removeAttribute('value');
    }
  }

  function toonRoute(r: Route, info: { laadtijd: number; regios: string[]; knopen: number }) {
    laatsteRoute = r;
    laatsteVogelvlucht = null;
    (kaart.getSource('vogelvlucht') as maplibregl.GeoJSONSource | undefined)?.setData(LEGE_DATA);
    tekenRoute(r);
    const samenvatting = `${km(r.afstand / 1000)} · ${duur(r.duur)}`;
    toonStatus('route', samenvatting, `${MODUS_NAAM[r.modus][0].toUpperCase()}${MODUS_NAAM[r.modus].slice(1)}, langs de wegen. Geschatte duur zonder wachttijden.`, [
      knop('Hele route tonen', () => toonInBeeld(r.lijn)),
      knop('Afdrukken', () => print()),
    ]);
    melding.textContent = `Route berekend: ${km(r.afstand / 1000)}, ${duur(r.duur)} ${MODUS_NAAM[r.modus]}. ${r.stappen.length} aanwijzingen.`;
    const namen = info.regios.map((id) => overzicht.find((o) => o.id === id)?.naam ?? id).join(', ');
    $('#technisch').textContent = `Berekend op dit toestel in ${Math.round(r.rekentijd + info.laadtijd)} ms met het routepakket ${namen}.`;
    const items = r.stappen.map((s, i) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.innerHTML = `${esc(s.tekst)}${s.afstand >= 1 ? ` <span class="afstand">${esc(km(s.afstand / 1000))}</span>` : ''}`;
      b.setAttribute('aria-label', `${s.tekst}${s.afstand >= 1 ? `, ${km(s.afstand / 1000)}` : ''}. Toon op de kaart.`);
      b.addEventListener('click', () => kaart.flyTo({ center: [s.lon, s.lat], zoom: Math.max(kaart.getZoom(), 16) }));
      li.append(b);
      li.dataset.stap = String(i);
      return li;
    });
    $('#stappen').replaceChildren(...items);
    $('#uitkomst').hidden = false;

    // Afdrukversie.
    $('#afdruk-punten').textContent = `Van ${punten.a?.naam ?? 'A'} naar ${punten.b?.naam ?? 'B'}`;
    $('#afdruk-samenvatting').textContent = `${samenvatting} ${MODUS_NAAM[r.modus]}`;
    $('#afdruk-stappen').replaceChildren(...r.stappen.map((s) => {
      const li = document.createElement('li');
      li.textContent = `${s.tekst}${s.afstand >= 1 ? ` — ${km(s.afstand / 1000)}` : ''}`;
      return li;
    }));
    toonInBeeld(r.lijn);
    // Een beeld van de kaart voor de afdruk, zodra de kaart klaar is met tekenen.
    kaart.once('idle', () => {
      kaart.once('render', () => { try { $<HTMLImageElement>('#afdruk-kaart').src = kaart.getCanvas().toDataURL('image/jpeg', 0.85); } catch {} });
      kaart.triggerRepaint();
    });
  }

  // ---------- Begintoestand: link (?van=lat,lon&naar=lat,lon&naam=...), anders bewaard ----------
  const q = new URLSearchParams(location.search);
  const leesPunt = (s: string | null, naam: string): Gekozen | null => {
    const m = /^(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)$/.exec(s ?? '');
    return m ? { lat: Number(m[1]), lon: Number(m[2]), naam } : null;
  };
  const bewaard = lees<Record<'a' | 'b', Gekozen | null>>('route-punten', { a: null, b: null });
  const qModus = q.get('modus');
  if (qModus === 'voet' || qModus === 'fiets' || qModus === 'auto') {
    modus = qModus;
    modusVelden.forEach((v) => (v.checked = v.value === modus));
  }
  const startA = leesPunt(q.get('van'), q.get('vannaam') || 'Gekozen vertrekpunt') ?? (q.has('naar') ? null : bewaard.a);
  const startB = leesPunt(q.get('naar'), q.get('naam') || 'Gekozen bestemming') ?? bewaard.b;
  // Niet op de kaart wachten: markeringen en rekenwerk werken ook als de kaart nog tekent.
  {
    zetPunt('a', startA, { rekenen: false });
    zetPunt('b', startB, { rekenen: false });
    if (startA && startB) rekenUit();
    else if (startB && !bewaardBeeld) kaart.jumpTo({ center: [startB.lon, startB.lat], zoom: 14 });
    else if (startB) kaart.flyTo({ center: [startB.lon, startB.lat], zoom: Math.max(kaart.getZoom(), 13) });
    if (!(startA && startB)) toonBasisStatus();
    if (startB && !startA) toonStatus('half', 'Bestemming gekozen. Kies nu een vertrekpunt (A)', 'Zoek een plaats, tik op "Kies op de kaart" of druk lang op de kaart.');
  }
  kaart.on('moveend', () => bewaar('kaartbeeld', { c: kaart.getCenter().toArray(), z: kaart.getZoom() }));
</script>

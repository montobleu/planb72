---
import App from '../../../layouts/App.astro';
---
<App titel="Route" tab="kaart" volledig>
  <main id="inhoud" class="kaart-pagina route-pagina">
    <h1 class="sr-only">Route plannen</h1>
    <div id="kaart" role="region" aria-label="Kaart voor de route. Lang drukken of rechtsklikken kiest A of B."></div>
    <div id="vizier" class="vizier" hidden aria-hidden="true"></div>
    <div class="kaart-paneel route-paneel niet-afdrukken">
      <details id="paneel" open>
        <summary>Route plannen</summary>
        <form id="routeform" novalidate>
          <fieldset class="modi">
            <legend>Vervoerswijze</legend>
            <label><input type="radio" name="modus" value="voet" checked />Te voet</label>
            <label><input type="radio" name="modus" value="fiets" />Fiets</label>
            <label><input type="radio" name="modus" value="auto" />Auto</label>
          </fieldset>

          {(['a', 'b'] as const).map((k) => (
            <div class="punt" data-punt={k}>
              <label for={`zoek-${k}`}>{k === 'a' ? 'Van (A)' : 'Naar (B)'}</label>
              <search>
                <input id={`zoek-${k}`} type="search" autocomplete="off" spellcheck="false"
                  placeholder="Plaats, straat, ziekenhuis, schuilplek…"
                  aria-describedby={`uitleg-${k}`} aria-controls={`treffers-${k}`} />
              </search>
              <ul id={`treffers-${k}`} class="treffers" hidden aria-label={k === 'a' ? 'Zoekresultaten voor A' : 'Zoekresultaten voor B'}></ul>
              <p id={`uitleg-${k}`} class="klein gekozen" data-gekozen={k}>Nog niet gekozen.</p>
              <div class="kleine-knoppen">
                <button type="button" class="knop klein-knop" data-kies={k}>Kies op de kaart</button>
                <button type="button" class="knop klein-knop" data-midden={k}>Midden van de kaart</button>
                {k === 'a' && <button type="button" class="knop klein-knop" id="mijn-positie" hidden>Mijn laatst bekende positie</button>}
              </div>
            </div>
          ))}

          <div class="kleine-knoppen">
            <button type="button" class="knop klein-knop" id="wissel">A en B wisselen</button>
            <button type="button" class="knop klein-knop" id="wis">Wissen</button>
          </div>
        </form>

        <div id="uitkomst" hidden>
          <h2 class="route-kop">Route</h2>
          <p id="samenvatting" class="samenvatting"></p>
          <p id="technisch" class="klein"></p>
          <div class="kleine-knoppen">
            <button type="button" class="knop klein-knop" id="afdrukken">Afdrukken</button>
          </div>
          <h3 class="route-kop">Aanwijzingen</h3>
          <ol id="stappen" class="aanwijzingen"></ol>
        </div>

        <div id="regio-aanbod" hidden></div>
        <progress id="laden" hidden aria-label="Route wordt berekend"></progress>
        <p id="melding" class="klein" role="status"></p>

        <details class="instellingen">
          <summary>Instellingen</summary>
          <label class="vink"><input type="checkbox" id="positieknop" /> Knop tonen om mijn laatst bekende positie als A te gebruiken</label>
          <p class="klein">Uit: PlanB72 vraagt nooit je positie. Aan: alleen als je op de knop tikt, één keer, zonder je te volgen.</p>
        </details>
        <p class="klein">Route berekend op dit toestel uit OpenStreetMap. Controleer ter plaatse: wegen kunnen afgesloten of beschadigd zijn. <a href="/app/pakket/">Routepakketten</a> · <a href="/app/kaart/">Kaart</a></p>
      </details>
    </div>

    <section id="afdruk" class="alleen-afdruk" aria-labelledby="afdruk-kop">
      <h2 id="afdruk-kop">Route</h2>
      <p id="afdruk-punten"></p>
      <p id="afdruk-samenvatting"></p>
      <img id="afdruk-kaart" alt="" />
      <ol id="afdruk-stappen" class="aanwijzingen"></ol>
      <p class="klein">PlanB72 · berekend zonder internet uit OpenStreetMap (© OpenStreetMap-bijdragers, ODbL). Controleer ter plaatse. Bij levensgevaar: bel 112.</p>
    </section>
  </main>
</App>

<style is:global>
  .route-paneel { width: min(23rem, calc(100% - 20px)); }
  .route-paneel fieldset { margin: 0.5rem 0; padding: 4px 10px 8px; }
  .route-paneel .modi { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .route-paneel .modi legend { font-size: 0.875rem; }
  .route-paneel .modi label { margin: 2px 0; min-height: 32px; }
  .route-paneel .punt { border-top: 1px solid var(--rand); padding-top: 4px; margin-top: 8px; }
  .route-paneel .punt > label { font-weight: 600; margin: 0.4rem 0 0.25rem; }
  .route-paneel input[type="search"] { min-height: 40px; padding: 6px 10px; }
  .route-paneel .gekozen { margin: 0.3rem 0; }
  .kleine-knoppen { display: flex; flex-wrap: wrap; gap: 6px; margin: 0.4rem 0; }
  .knop.klein-knop { min-height: 36px; padding: 0 10px; font-size: 0.875rem; }
  .knop.klein-knop[aria-pressed="true"] { background: var(--merk); color: var(--merk-tekst); border-color: var(--merk); }
  .treffers { list-style: none; margin: 4px 0; padding: 0; border: 1px solid var(--rand-sterk); border-radius: var(--radius); max-height: 16rem; overflow: auto; }
  .treffers li + li { border-top: 1px solid var(--rand); }
  .treffers button { display: block; width: 100%; text-align: left; background: var(--bg); color: var(--tekst); border: 0; padding: 8px 10px; font: inherit; cursor: pointer; min-height: 40px; }
  .treffers button:hover, .treffers button:focus-visible { background: var(--bg-2); }
  .treffers .klein { display: block; }
  .route-kop { font-size: 0.95rem; margin: 0.8rem 0 0.2rem; }
  .samenvatting { font-size: 1.1rem; font-weight: 600; margin: 0.2rem 0; font-variant-numeric: tabular-nums; }
  .aanwijzingen { margin: 0.3rem 0; padding-left: 1.6rem; }
  .aanwijzingen li { padding: 4px 0; border-bottom: 1px solid var(--rand); }
  .aanwijzingen button { all: unset; cursor: pointer; display: block; width: 100%; }
  .aanwijzingen button:focus-visible { outline: 2px solid var(--merk); outline-offset: 2px; }
  .aanwijzingen .afstand { color: var(--tekst-2); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .route-paneel .instellingen { margin: 0.6rem 0; }
  .route-paneel .instellingen summary { font-weight: 400; font-size: 0.9rem; }
  .route-paneel label.vink { align-items: flex-start; }
  .route-paneel progress { width: 100%; }
  .route-paneel :focus-visible { outline: 2px solid var(--merk); outline-offset: 2px; }
  #kaart:has(canvas:focus-visible) { outline: 3px solid var(--merk); outline-offset: -3px; }
  .vizier { position: absolute; left: 50%; top: 50%; width: 28px; height: 28px; margin: -14px 0 0 -14px; pointer-events: none; z-index: 4; }
  .vizier::before, .vizier::after { content: ""; position: absolute; background: var(--tekst); }
  .vizier::before { left: 13px; top: 0; width: 2px; height: 28px; }
  .vizier::after { top: 13px; left: 0; height: 2px; width: 28px; }
  .markering { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-family: var(--font); color: #fff; border: 2px solid #fff; box-shadow: 0 1px 4px #0008; cursor: grab; }
  .markering.a { background: #1d6b40; }
  .markering.b { background: #b42318; }
  .keuze-popup { display: flex; flex-direction: column; gap: 6px; }
  .alleen-afdruk { display: none; }
  .route-paneel [hidden] { display: none !important; }
  @media (max-width: 640px) {
    .route-paneel { top: auto; bottom: 10px; max-height: 62%; }
  }
  @media print {
    .route-pagina { position: static; }
    .route-pagina #kaart, .route-pagina .vizier, .maplibregl-control-container { display: none !important; }
    .alleen-afdruk { display: block; }
    #afdruk-kaart { max-width: 100%; max-height: 10cm; border: 1px solid #999; }
    #afdruk-kaart:not([src]) { display: none; }
    .aanwijzingen li { break-inside: avoid; }
  }
</style>

<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import * as maplibregl from 'maplibre-gl';
  import { basiskaart, herlaadBijKleurwissel, kaartfoutTekst } from '../../../lib/basiskaart';
  import { routeOverzicht, routesOpToestel, downloadRoute, type Routepakket } from '../../../lib/routepakketten';
  import { lees, bewaar, km, vraagBlijvendeOpslag } from '../../../lib/app';
  import { mb } from '../../../lib/kaarten';
  import type { Modus, Punt, Route } from '../../../lib/route';
  import type { Treffer } from '../../../lib/route.worker';

  type Gekozen = Punt & { naam: string };
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const melding = $('#melding');
  const laden = $<HTMLProgressElement>('#laden');
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const MODUS_NAAM: Record<Modus, string> = { voet: 'te voet', fiets: 'met de fiets', auto: 'met de auto' };

  if (matchMedia('(max-width: 640px)').matches && lees('route-paneel-dicht', false)) $<HTMLDetailsElement>('#paneel').open = false;
  $<HTMLDetailsElement>('#paneel').addEventListener('toggle', (e) => bewaar('route-paneel-dicht', !(e.target as HTMLDetailsElement).open));

  // ---------- Kaart ----------
  herlaadBijKleurwissel();
  const basis = await basiskaart();
  if (basis.melding) melding.textContent = basis.melding;
  const bewaardBeeld = lees<{ c: [number, number]; z: number } | null>('kaartbeeld', null);
  const kaart = new maplibregl.Map({
    container: 'kaart',
    style: basis.stijl,
    center: bewaardBeeld?.c ?? [4.47, 50.64],
    zoom: bewaardBeeld?.z ?? 7,
    maxZoom: 18,
    attributionControl: { compact: true },
    fadeDuration: 0,
  });
  (window as any).__kaart = kaart;
  kaart.on('error', (e) => { console.error('Kaartfout', e.error); melding.textContent = kaartfoutTekst(e.error, basis.lokaal); });
  kaart.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  kaart.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-right');
  const routeKleur = basis.licht ? '#12385c' : '#9cc3e8';
  kaart.on('load', () => {
    kaart.addSource('route', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    kaart.addLayer({ id: 'route-rand', type: 'line', source: 'route', layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': basis.licht ? '#ffffff' : '#0e1318', 'line-width': ['interpolate', ['linear'], ['zoom'], 8, 5, 16, 11] } });
    kaart.addLayer({ id: 'route-lijn', type: 'line', source: 'route', layout: { 'line-cap': 'round', 'line-join': 'round' },
      paint: { 'line-color': routeKleur, 'line-width': ['interpolate', ['linear'], ['zoom'], 8, 3, 16, 7] } });
    if (laatsteRoute) tekenRoute(laatsteRoute);
  });

  // ---------- Rekenwerk in een Web Worker ----------
  const werker = new Worker(new URL('../../../lib/route.worker.ts', import.meta.url), { type: 'module' });
  let vraagNr = 0;
  const wachtend = new Map<number, { ok: (v: any) => void; nee: (e: Error) => void }>();
  werker.onmessage = (ev) => {
    const d = ev.data;
    if (d.soort === 'voortgang') { melding.textContent = d.tekst; return; }
    const w = wachtend.get(d.nr);
    if (!w) return;
    wachtend.delete(d.nr);
    if (d.soort === 'fout') w.nee(new Error(d.tekst)); else w.ok(d);
  };
  function vraag<T>(bericht: Record<string, unknown>): Promise<T> {
    const nr = ++vraagNr;
    return new Promise((ok, nee) => { wachtend.set(nr, { ok, nee }); werker.postMessage({ ...bericht, nr }); });
  }

  let overzicht: Routepakket[] = [];
  let opToestel = new Map<string, Blob>();
  async function meldPakketten() {
    overzicht = await routeOverzicht();
    opToestel = await routesOpToestel();
    werker.postMessage({
      soort: 'pakketten',
      pakketten: overzicht.filter((p) => opToestel.has(p.id)).map((p) => ({ id: p.id, bbox: p.bbox, bestand: opToestel.get(p.id) })),
    });
    if (!opToestel.size) toonAanbod(null, 'Er staat nog geen routepakket op dit toestel.');
  }
  await meldPakketten();

  // ---------- Punten A en B ----------
  const punten: Record<'a' | 'b', Gekozen | null> = { a: null, b: null };
  const markers: Record<'a' | 'b', maplibregl.Marker | null> = { a: null, b: null };
  let modus: Modus = 'voet';
  let laatsteRoute: Route | null = null;

  const graden = (p: Punt) => `${p.lat.toFixed(5)}, ${p.lon.toFixed(5)}`;

  function zetPunt(k: 'a' | 'b', p: Gekozen | null, { vlieg = false, rekenen = true } = {}) {
    punten[k] = p;
    markers[k]?.remove();
    markers[k] = null;
    const uitleg = $(`[data-gekozen="${k}"]`);
    if (p) {
      const el = document.createElement('div');
      el.className = `markering ${k}`;
      el.textContent = k.toUpperCase();
      el.setAttribute('aria-hidden', 'true');
      const m = new maplibregl.Marker({ element: el, draggable: true }).setLngLat([p.lon, p.lat]).addTo(kaart);
      m.on('dragend', () => {
        const ll = m.getLngLat();
        zetPunt(k, { lon: ll.lng, lat: ll.lat, naam: `Punt op de kaart (${graden({ lon: ll.lng, lat: ll.lat })})` });
      });
      markers[k] = m;
      uitleg.textContent = p.naam;
      if (vlieg) kaart.flyTo({ center: [p.lon, p.lat], zoom: Math.max(kaart.getZoom(), 14) });
    } else uitleg.textContent = 'Nog niet gekozen.';
    bewaar('route-punten', punten);
    if (rekenen) rekenUit();
  }

  // Kiezen op de kaart: één tik na "Kies op de kaart", of lang drukken / rechtsklikken.
  let kiesModus: 'a' | 'b' | null = null;
  const kiesKnoppen = [...document.querySelectorAll<HTMLButtonElement>('[data-kies]')];
  kiesKnoppen.forEach((b) => b.setAttribute('aria-pressed', 'false'));
  function zetKiesModus(k: 'a' | 'b' | null) {
    kiesModus = k;
    kiesKnoppen.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kies === k)));
    kaart.getCanvas().style.cursor = k ? 'crosshair' : '';
    if (k) melding.textContent = `Tik op de kaart om ${k.toUpperCase()} te kiezen.`;
  }
  kiesKnoppen.forEach((b) => b.addEventListener('click', () => zetKiesModus(kiesModus === b.dataset.kies ? null : (b.dataset.kies as 'a' | 'b'))));
  kaart.on('click', (e) => {
    if (!kiesModus) return;
    const k = kiesModus;
    zetKiesModus(null);
    zetPunt(k, { lon: e.lngLat.lng, lat: e.lngLat.lat, naam: `Punt op de kaart (${graden({ lon: e.lngLat.lng, lat: e.lngLat.lat })})` });
  });

  let keuzePopup: maplibregl.Popup | null = null;
  function toonKeuze(ll: maplibregl.LngLat) {
    keuzePopup?.remove();
    const doos = document.createElement('div');
    doos.className = 'keuze-popup';
    for (const k of ['a', 'b'] as const) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'knop klein-knop';
      b.textContent = k === 'a' ? 'Vertrek hier (A)' : 'Bestemming hier (B)';
      b.addEventListener('click', () => {
        keuzePopup?.remove();
        zetPunt(k, { lon: ll.lng, lat: ll.lat, naam: `Punt op de kaart (${graden({ lon: ll.lng, lat: ll.lat })})` });
      });
      doos.append(b);
    }
    keuzePopup = new maplibregl.Popup({ maxWidth: '240px', focusAfterOpen: true }).setLngLat(ll).setDOMContent(doos).addTo(kaart);
  }
  kaart.on('contextmenu', (e) => toonKeuze(e.lngLat));
  let drukTimer = 0;
  kaart.on('touchstart', (e) => {
    if (e.originalEvent.touches.length !== 1) return;
    const ll = e.lngLat;
    clearTimeout(drukTimer);
    drukTimer = window.setTimeout(() => toonKeuze(ll), 550);
  });
  for (const ev of ['touchend', 'touchmove', 'touchcancel', 'movestart'] as const) kaart.on(ev, () => clearTimeout(drukTimer));

  // Met het toetsenbord: kaart verschuiven met de pijltjes, dan "Midden van de kaart".
  const vizier = $('#vizier');
  const kaartEl = $('#kaart');
  kaartEl.addEventListener('focusin', () => (vizier.hidden = false));
  kaartEl.addEventListener('focusout', () => (vizier.hidden = true));
  document.querySelectorAll<HTMLButtonElement>('[data-midden]').forEach((b) =>
    b.addEventListener('click', () => {
      const c = kaart.getCenter();
      zetPunt(b.dataset.midden as 'a' | 'b', { lon: c.lng, lat: c.lat, naam: `Midden van de kaart (${graden({ lon: c.lng, lat: c.lat })})` });
    })
  );

  // Optioneel: laatst bekende positie, één keer opgevraagd, standaard uit.
  const positieVink = $<HTMLInputElement>('#positieknop');
  const positieKnop = $<HTMLButtonElement>('#mijn-positie');
  positieVink.checked = lees('route-positieknop', false);
  positieKnop.hidden = !positieVink.checked;
  positieVink.addEventListener('change', () => { bewaar('route-positieknop', positieVink.checked); positieKnop.hidden = !positieVink.checked; });
  positieKnop.addEventListener('click', () => {
    if (!('geolocation' in navigator)) { melding.textContent = 'Dit toestel geeft geen positie.'; return; }
    melding.textContent = 'Laatst bekende positie opvragen…';
    navigator.geolocation.getCurrentPosition(
      (p) => zetPunt('a', { lon: p.coords.longitude, lat: p.coords.latitude, naam: 'Mijn laatst bekende positie' }, { vlieg: true }),
      () => (melding.textContent = 'Geen positie beschikbaar. Kies A op de kaart of zoek een plaats.'),
      { enableHighAccuracy: false, maximumAge: Infinity, timeout: 15000 }
    );
  });

  // ---------- Zoeken ----------
  let zoekTimer = 0;
  let meldTimer = 0;
  for (const k of ['a', 'b'] as const) {
    const veld = $<HTMLInputElement>(`#zoek-${k}`);
    const lijst = $<HTMLUListElement>(`#treffers-${k}`);
    let treffers: Treffer[] = [];
    const kies = (t: Treffer) => {
      lijst.hidden = true;
      veld.value = '';
      zetPunt(k, { lon: t.lon, lat: t.lat, naam: t.context ? `${t.naam}, ${t.context}` : t.naam }, { vlieg: true });
      veld.focus();
    };
    veld.addEventListener('input', () => {
      clearTimeout(zoekTimer);
      const tekst = veld.value.trim();
      if (tekst.length < 2) { lijst.hidden = true; lijst.replaceChildren(); return; }
      zoekTimer = window.setTimeout(async () => {
        const c = kaart.getCenter();
        try {
          const uit = await vraag<{ treffers: Treffer[] }>({ soort: 'zoek', tekst, nabij: { lon: c.lng, lat: c.lat } });
          if (veld.value.trim() !== tekst) return;
          treffers = uit.treffers;
          lijst.replaceChildren(...treffers.map((t) => {
            const li = document.createElement('li');
            const b = document.createElement('button');
            b.type = 'button';
            b.innerHTML = `<strong>${esc(t.naam)}</strong><span class="klein">${esc([t.soort, t.context].filter(Boolean).join(' · '))}</span>`;
            b.addEventListener('click', () => kies(t));
            b.addEventListener('keydown', (e) => {
              const knoppen = [...lijst.querySelectorAll('button')];
              const i = knoppen.indexOf(b);
              if (e.key === 'ArrowDown') { e.preventDefault(); knoppen[i + 1]?.focus(); }
              if (e.key === 'ArrowUp') { e.preventDefault(); (knoppen[i - 1] ?? veld).focus(); }
              if (e.key === 'Escape') { lijst.hidden = true; veld.focus(); }
            });
            li.append(b);
            return li;
          }));
          lijst.hidden = !treffers.length;
          // Aantal resultaten pas na een korte pauze melden, zodat een schermlezer niet bij elke toets praat.
          clearTimeout(meldTimer);
          meldTimer = window.setTimeout(() => {
            melding.textContent = treffers.length
              ? `${treffers.length} resultaten. Pijl omlaag om te kiezen.`
              : opToestel.size ? 'Niets gevonden in de routepakketten op dit toestel.' : 'Niets gevonden. Download een routepakket om op straat en plaats te zoeken.';
          }, 700);
        } catch (e) {
          melding.textContent = (e as Error).message;
        }
      }, 180);
    });
    veld.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && !lijst.hidden) { e.preventDefault(); lijst.querySelector('button')?.focus(); }
      if (e.key === 'Enter') { e.preventDefault(); if (treffers[0] && !lijst.hidden) kies(treffers[0]); }
      if (e.key === 'Escape') lijst.hidden = true;
    });
  }
  $('#routeform').addEventListener('submit', (e) => e.preventDefault());

  // ---------- Vervoerswijze, wisselen, wissen ----------
  const modusVelden = [...document.querySelectorAll<HTMLInputElement>('input[name="modus"]')];
  modus = lees<Modus>('route-modus', 'voet');
  modusVelden.forEach((v) => {
    v.checked = v.value === modus;
    v.addEventListener('change', () => { modus = v.value as Modus; bewaar('route-modus', modus); rekenUit(); });
  });
  $('#wissel').addEventListener('click', () => {
    const { a, b } = punten;
    zetPunt('a', b, { rekenen: false });
    zetPunt('b', a);
  });
  $('#wis').addEventListener('click', () => {
    zetPunt('a', null, { rekenen: false });
    zetPunt('b', null, { rekenen: false });
    wisRoute();
    melding.textContent = 'A en B gewist.';
  });

  // ---------- Route ----------
  function duur(s: number) {
    const min = Math.max(1, Math.round(s / 60));
    if (min < 60) return `${min} min`;
    return `${Math.floor(min / 60)} u ${String(min % 60).padStart(2, '0')} min`;
  }

  function wisRoute() {
    laatsteRoute = null;
    $('#uitkomst').hidden = true;
    (kaart.getSource('route') as maplibregl.GeoJSONSource | undefined)?.setData({ type: 'FeatureCollection', features: [] });
  }

  function tekenRoute(r: Route) {
    (kaart.getSource('route') as maplibregl.GeoJSONSource | undefined)?.setData({
      type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: r.lijn },
    });
  }

  let rekenNr = 0;
  async function rekenUit() {
    const { a, b } = punten;
    toonAanbod(null);
    if (!a || !b) { wisRoute(); return; }
    const nr = ++rekenNr;
    laden.hidden = false;
    try {
      const uit = await vraag<{ route: Route; laadtijd: number; regios: string[]; knopen: number }>({ soort: 'route', van: a, naar: b, modus });
      if (nr !== rekenNr) return;
      toonRoute(uit.route, uit);
    } catch (e) {
      if (nr !== rekenNr) return;
      wisRoute();
      melding.textContent = (e as Error).message;
      const buiten = [a, b].filter((p) => !overzicht.some((o) => opToestel.has(o.id) && binnen(p, o.bbox)));
      if (buiten.length) toonAanbod(buiten);
    } finally {
      if (nr === rekenNr) laden.hidden = true;
    }
  }

  const binnen = (p: Punt, b: number[]) => p.lon >= b[0] && p.lon <= b[2] && p.lat >= b[1] && p.lat <= b[3];

  /** Bied de regio's aan die nodig zijn voor punten buiten de pakketten op dit toestel. */
  function toonAanbod(buiten: Punt[] | null, tekst?: string) {
    const doos = $('#regio-aanbod');
    const nodig = buiten
      ? overzicht.filter((o) => !opToestel.has(o.id) && buiten.some((p) => binnen(p, o.bbox)))
      : tekst ? [] : null;
    if (!nodig) { doos.hidden = true; doos.replaceChildren(); return; }
    doos.replaceChildren();
    const p = document.createElement('p');
    p.className = 'klein';
    p.textContent = tekst ?? 'Hiervoor is een routepakket nodig:';
    doos.append(p);
    const rij = document.createElement('div');
    rij.className = 'kleine-knoppen';
    for (const o of nodig.slice(0, 3)) {
      const knop = document.createElement('button');
      knop.type = 'button';
      knop.className = 'knop klein-knop';
      knop.textContent = `${o.naam} downloaden (${mb(o.bytes)})`;
      knop.addEventListener('click', async () => {
        if (!navigator.onLine) { melding.textContent = 'Geen verbinding. Download het pakket later, of via Instellingen.'; return; }
        knop.disabled = true;
        await vraagBlijvendeOpslag();
        laden.hidden = false;
        try {
          await downloadRoute(o, (f) => (laden.value = f));
          melding.textContent = `Routes ${o.naam} staan op dit toestel.`;
          await meldPakketten();
          rekenUit();
        } catch {
          melding.textContent = `Download van ${o.naam} mislukt. Probeer opnieuw.`;
          knop.disabled = false;
        } finally {
          laden.hidden = true;
          laden.removeAttribute('value');
        }
      });
      rij.append(knop);
    }
    const link = document.createElement('a');
    link.href = '/app/pakket/#routes-kop';
    link.className = 'klein';
    link.textContent = 'Alle routepakketten';
    doos.append(rij, link);
    doos.hidden = false;
  }

  function toonRoute(r: Route, info: { laadtijd: number; regios: string[]; knopen: number }) {
    laatsteRoute = r;
    tekenRoute(r);
    const samenvatting = `${km(r.afstand / 1000)} · ${duur(r.duur)} ${MODUS_NAAM[r.modus]}`;
    $('#samenvatting').textContent = samenvatting;
    const namen = info.regios.map((id) => overzicht.find((o) => o.id === id)?.naam ?? id).join(', ');
    $('#technisch').textContent = `Berekend op dit toestel in ${Math.round(r.rekentijd + info.laadtijd)} ms (${namen}). Geschatte duur zonder wachttijden.`;
    const items = r.stappen.map((s, i) => {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.innerHTML = `${esc(s.tekst)}${s.afstand >= 1 ? ` <span class="afstand">${esc(km(s.afstand / 1000))}</span>` : ''}`;
      b.setAttribute('aria-label', `${s.tekst}${s.afstand >= 1 ? `, ${km(s.afstand / 1000)}` : ''}. Toon op de kaart.`);
      b.addEventListener('click', () => kaart.flyTo({ center: [s.lon, s.lat], zoom: Math.max(kaart.getZoom(), 16) }));
      li.append(b);
      li.dataset.stap = String(i);
      return li;
    });
    $('#stappen').replaceChildren(...items);
    $('#uitkomst').hidden = false;
    // Op een smal scherm staat het resultaat onder het formulier: in beeld brengen.
    if (matchMedia('(max-width: 640px)').matches) $('#uitkomst').scrollIntoView({ block: 'nearest' });
    melding.textContent = `Route berekend: ${samenvatting.replace(' · ', ', ')}. ${r.stappen.length} aanwijzingen.`;

    // Afdrukversie.
    $('#afdruk-punten').textContent = `Van ${punten.a?.naam ?? 'A'} naar ${punten.b?.naam ?? 'B'}`;
    $('#afdruk-samenvatting').textContent = samenvatting;
    $('#afdruk-stappen').replaceChildren(...r.stappen.map((s) => {
      const li = document.createElement('li');
      li.textContent = `${s.tekst}${s.afstand >= 1 ? ` — ${km(s.afstand / 1000)}` : ''}`;
      return li;
    }));
    const b = new maplibregl.LngLatBounds();
    for (const p of r.lijn) b.extend(p);
    const paneel = document.querySelector('.route-paneel') as HTMLElement;
    const smal = matchMedia('(max-width: 640px)').matches;
    kaart.fitBounds(b, {
      padding: smal ? { top: 40, bottom: Math.min(paneel.offsetHeight + 20, innerHeight * 0.6), left: 30, right: 30 }
        : { top: 40, bottom: 40, left: Math.min(paneel.offsetWidth + 30, innerWidth / 2), right: 50 },
      maxZoom: 16,
    });
    // Een beeld van de kaart voor de afdruk, zodra de kaart klaar is met tekenen.
    kaart.once('idle', () => {
      kaart.once('render', () => { try { $<HTMLImageElement>('#afdruk-kaart').src = kaart.getCanvas().toDataURL('image/jpeg', 0.85); } catch {} });
      kaart.triggerRepaint();
    });
  }
  $('#afdrukken').addEventListener('click', () => print());

  // ---------- Begintoestand: link (?van=lat,lon&naar=lat,lon&naam=...), anders bewaard ----------
  const q = new URLSearchParams(location.search);
  const leesPunt = (s: string | null, naam: string): Gekozen | null => {
    const m = /^(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)$/.exec(s ?? '');
    return m ? { lat: Number(m[1]), lon: Number(m[2]), naam } : null;
  };
  const bewaard = lees<Record<'a' | 'b', Gekozen | null>>('route-punten', { a: null, b: null });
  const qModus = q.get('modus');
  if (qModus === 'voet' || qModus === 'fiets' || qModus === 'auto') {
    modus = qModus;
    modusVelden.forEach((v) => (v.checked = v.value === modus));
  }
  const startA = leesPunt(q.get('van'), q.get('vannaam') || 'Gekozen vertrekpunt') ?? (q.has('naar') ? null : bewaard.a);
  const startB = leesPunt(q.get('naar'), q.get('naam') || 'Gekozen bestemming') ?? bewaard.b;
  // Niet op de kaart wachten: markeringen en rekenwerk werken ook als de kaart nog tekent.
  {
    zetPunt('a', startA, { rekenen: false });
    zetPunt('b', startB, { rekenen: false });
    if (startA && startB) rekenUit();
    else if (startB && !bewaardBeeld) kaart.jumpTo({ center: [startB.lon, startB.lat], zoom: 14 });
    else if (startB) kaart.flyTo({ center: [startB.lon, startB.lat], zoom: Math.max(kaart.getZoom(), 13) });
    if (startB && !startA) melding.textContent = 'Bestemming gekozen. Kies nu A: zoek een plaats, tik op "Kies op de kaart" of druk lang op de kaart.';
  }
  kaart.on('moveend', () => bewaar('kaartbeeld', { c: kaart.getCenter().toArray(), z: kaart.getZoom() }));
</script>

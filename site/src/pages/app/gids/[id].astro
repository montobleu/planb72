---
import App from '../../../layouts/App.astro';
import Concept from '../../../components/Concept.astro';
import Inhoudstafel from '../../../components/Inhoudstafel.astro';
import Brondoos from '../../../components/Brondoos.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const gidsen = await getCollection('gidsen');
  return gidsen.map((g) => ({ params: { id: g.id }, props: { gids: g } }));
}
const { gids } = Astro.props;
const { Content, headings } = await render(gids);
const d = gids.data;
---
<App titel={d.titel} tab="meer">
  <p class="klein niet-afdrukken"><a href="/app/gidsen/">Alle gidsen</a></p>
  <h1>{d.titel}</h1>
  <p class="lead">{d.kort}</p>
  {d.status === 'concept' && <Concept bron={d.bronnen[0].url} bronNaam={d.bronnen[0].naam} />}
  <Inhoudstafel koppen={headings} />
  <article class="inhoud"><Content /></article>
  <Brondoos bronnen={d.bronnen} datum={d.datum} status={d.status} nagekeken_door={d.nagekeken_door} />
  <div class="knoppen niet-afdrukken"><button class="knop" type="button" onclick="print()">Afdrukken</button></div>
</App>

---
import App from '../../../layouts/App.astro';
import GidsLinks from '../../../components/GidsLinks.astro';
---
<App titel="Kompas" tab="meer">
  <h1>Kompas</h1>
  <p class="dempen">Gebruikt de sensoren van je telefoon; werkt zonder netwerk. Hou de telefoon plat en weg van metaal.</p>
  <div style="display:grid;place-items:center;margin:1.5rem 0">
    <svg id="roos" viewBox="-110 -110 220 220" width="260" height="260" role="img" aria-label="Kompasroos">
      <circle r="100" fill="none" stroke="var(--rand)" stroke-width="3" />
      <g id="draai">
        <text y="-78" text-anchor="middle" fill="var(--gevaar)" font-size="22" font-weight="800">N</text>
        <text y="92" text-anchor="middle" fill="var(--tekst)" font-size="20">Z</text>
        <text x="84" y="7" text-anchor="middle" fill="var(--tekst)" font-size="20">O</text>
        <text x="-84" y="7" text-anchor="middle" fill="var(--tekst)" font-size="20">W</text>
        <path d="M0-62 10 0H-10Z" fill="var(--gevaar)" /><path d="M0 62 10 0H-10Z" fill="var(--tekst-2)" />
      </g>
      <path d="M0-108v16" stroke="var(--accent)" stroke-width="4" />
    </svg>
    <p id="koers" style="font-size:2rem;font-weight:800;margin:.5rem 0" aria-live="polite">—</p>
    <button class="knop hoofd" type="button" id="start">Kompas starten</button>
  </div>
  <div class="melding klein">
    Zonder kompassensor: de zon staat rond 13u30 (zomertijd) ongeveer in het zuiden, rond 12u30 in de winter. 's Nachts wijst de Poolster het noorden.
  </div>
  <GidsLinks ids={['navigatie-zonder-gps', 'buiten-overleven']} />
</App>
<script>
  const draai = document.getElementById('draai')!;
  const koers = document.getElementById('koers')!;
  const streken = ['N', 'NO', 'O', 'ZO', 'Z', 'ZW', 'W', 'NW'];
  function zet(graden: number) {
    draai.setAttribute('transform', `rotate(${-graden})`);
    koers.textContent = `${Math.round(graden)}° ${streken[Math.round(graden / 45) % 8]}`;
  }
  function luister() {
    const h = (e: any) => {
      let g: number | null = null;
      if (typeof e.webkitCompassHeading === 'number') g = e.webkitCompassHeading;
      else if (e.absolute && typeof e.alpha === 'number') g = (360 - e.alpha) % 360;
      if (g !== null) zet(g);
    };
    addEventListener('deviceorientationabsolute', h);
    addEventListener('deviceorientation', h);
    setTimeout(() => { if (koers.textContent === '—') koers.textContent = 'Geen kompas op dit toestel'; }, 3000);
  }
  document.getElementById('start')!.addEventListener('click', async () => {
    const D: any = (window as any).DeviceOrientationEvent;
    if (D && typeof D.requestPermission === 'function') {
      try { if ((await D.requestPermission()) !== 'granted') { koers.textContent = 'Geen toestemming'; return; } } catch { koers.textContent = 'Geen toestemming'; return; }
    }
    luister();
  });
</script>

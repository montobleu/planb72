---
import App from '../../layouts/App.astro';
import { land } from '../../lib/data';
const groepen: [string, [string, string, string][]][] = [
  ['Bij nood', [
    ['/app/wat-nu/', 'Wat nu?', 'Eerste stappen per situatie'],
    ['/app/noodnummers/', 'Noodnummers', '112, 101, antigif, wachtdiensten'],
    ['/app/info/', 'Officiële informatie', 'BE-Alert, radio, 1771'],
  ]],
  ['Kaart en risico', [
    ['/app/kaart/', 'Kaart', 'Ziekenhuizen, politie, brandweer, water, AED'],
    ['/app/nucleair/', 'Nucleair', 'Sites, noodplanningszones, afstand'],
    ['/app/schuilen/', 'Schuilen', 'Waarheen bij welke dreiging'],
  ]],
  ['Voorbereiden', [
    ['/app/voorraad/', 'Voorraadplanner', 'Water voor personen en dagen'],
    ['/app/checklists/', 'Checklists', 'Noodpakket, vluchttas, auto'],
    ['/app/noodplan/', 'Gezinsnoodplan', 'Invullen en afdrukken'],
    ['/app/eerste-hulp/', 'Eerste hulp', 'Reanimatie, bloeding, verslikking en meer'],
    ['/app/gidsen/', 'Gidsen', 'Water, voedsel, warmte, evacuatie, communicatie'],
  ]],
  ['Hulpmiddelen', [
    ['/app/signalen/', 'Signalen', 'SOS met licht, morse, radio'],
    ['/app/kompas/', 'Kompas', 'Richting zonder netwerk'],
    ['/app/notities/', 'Notities', 'Logboek op dit toestel'],
    ['/app/pakket/', 'Instellingen en pakket', 'Offline zetten, weergave, opslag'],
  ]],
];
---
<App titel="Start" tab="start">
  <h1 class="sr-only">PlanB72</h1>
  <div class="melding gevaar" style="margin-top:1rem">
    <strong>Levensgevaar: bel <a href="tel:112">112</a>.</strong> Politie: <a href="tel:101">101</a>.
    PlanB72 vervangt de hulpdiensten niet.
  </div>

  <div id="pakket-melding" class="melding" hidden>
    <strong>Nog niet offline beschikbaar.</strong> Zet het pakket {land.naam.nl} op dit toestel zolang je verbinding hebt.
    <div class="knoppen"><a class="knop hoofd" href="/app/pakket/">Pakket downloaden</a></div>
  </div>

  {groepen.map(([titel, items]) => (
    <section>
      <h2 class="sectiekop">{titel}</h2>
      <div class="raster">
        {items.map(([href, t, uitleg]) => (
          <a class="tegel" href={href}><strong>{t}</strong><span class="klein">{uitleg}</span></a>
        ))}
      </div>
    </section>
  ))}

  <p class="klein" style="margin-top:1.5rem">{land.naam.nl} · landinfo van {land.bijgewerkt} · testversie</p>
</App>
<script>
  import { opToestel } from '../../lib/kaarten';
  // Toon de melding als het basispakket (kaartlagen en overzichtskaarten) nog niet op het toestel staat.
  (async () => {
    try {
      const lagen = (await caches.keys()).includes('pb72-pakket-be');
      const kaarten = await opToestel();
      const heeft = lagen && kaarten.has('be-z9');
      // ?voorbeeld verbergt de melding voor de schermafbeelding op de website.
      if (!heeft && !location.search.includes('voorbeeld')) document.getElementById('pakket-melding')!.hidden = false;
    } catch {}
  })();
</script>

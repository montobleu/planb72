---
import App from '../../../layouts/App.astro';
import { getCollection } from 'astro:content';
const MODULES: [string, string][] = [
  ['schuilen', 'Schuilen'],
  ['nucleair', 'Nucleair en straling'],
  ['voorbereiding', 'Voorbereiden'],
  ['water', 'Water'],
  ['voedsel', 'Voedsel'],
  ['warmte', 'Warmte en koelte'],
  ['energie', 'Licht en energie'],
  ['hygiene', 'Hygiëne en sanitair'],
  ['evacuatie', 'Evacuatie'],
  ['communicatie', 'Communicatie en alarmering'],
  ['dieren', 'Dieren'],
  ['gezondheid', 'Gezondheid'],
  ['buiten', 'Buiten en onderweg'],
];
const gidsen = (await getCollection('gidsen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<App titel="Gidsen" tab="meer">
  <h1>Gidsen</h1>
  <p class="lead">Uitgebreide naslag per onderwerp, samengesteld uit officiële en erkende bronnen.</p>
  {MODULES.map(([id, naam]) => {
    const lijst = gidsen.filter((g) => g.data.module === id);
    return lijst.length > 0 && (
      <section>
        <h2 class="sectiekop">{naam}</h2>
        <div class="raster">
          {lijst.map((g) => <a class="tegel" href={`/app/gids/${g.id}/`}><strong>{g.data.titel}</strong><span class="klein">{g.data.kort}</span></a>)}
        </div>
      </section>
    );
  })}
  {gidsen.length === 0 && <p>De gidsen worden samengesteld.</p>}
</App>

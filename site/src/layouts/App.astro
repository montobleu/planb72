---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Thema from '../components/Thema.astro';
interface Props { titel: string; tab?: 'start' | 'watnu' | 'kaart' | 'nummers' | 'meer'; volledig?: boolean; zoekbaar?: boolean }
const { titel, tab, volledig = false, zoekbaar = true } = Astro.props;
const tabs = [
  ['start', '/app/', 'Start'],
  ['watnu', '/app/wat-nu/', 'Wat nu?'],
  ['kaart', '/app/kaart/', 'Kaart'],
  ['nummers', '/app/noodnummers/', 'Nummers'],
  ['meer', '/app/meer/', 'Meer'],
] as const;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <Thema />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e1318" media="(prefers-color-scheme: dark)" />
  <title>{titel} · PlanB72</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <!-- Cookieloze bezoekersstatistiek (Nvivio), via ons eigen domein. Zie /privacy/. -->
  <script is:inline defer src="/stats/script.js"></script>
  <link rel="apple-touch-icon" href="/icons/icoon-192.png" />
  <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <slot name="head" />
</head>
<body class="app-body">
  <a class="naar-inhoud" href="#inhoud">Naar de inhoud</a>
  <header class="kop app-kop">
    <div class="wrap">
      <a class="logo" href="/app/"><Logo /><span>Plan<b>B72</b></span></a>
      <nav aria-label="Snelmenu">
        <a href="/app/zoeken/">Zoeken</a>
        <a href="/app/pakket/" title="Verbinding en pakket"><span class="status-stip" id="netstip"></span><span class="sr-only" id="nettekst">Status</span></a>
      </nav>
    </div>
  </header>
  {volledig ? <slot /> : (
    <main id="inhoud" class="wrap" data-pagefind-body={zoekbaar ? '' : undefined}>
      <slot />
    </main>
  )}
  <nav class="onderbalk" aria-label="Hoofdmenu app">
    {tabs.map(([id, href, tekst]) => (
      <a href={href} aria-current={tab === id ? 'page' : undefined}>{tekst}</a>
    ))}
  </nav>
  <script>
    import { startApp } from '../lib/app';
    startApp();
  </script>
</body>
</html>
